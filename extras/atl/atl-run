#!/bin/sh
# Run an Android app under Android Translation Layer on its own sway workspace,
# like an Android app switcher: one app per workspace. If the app already has a
# window, just focus it.
# usage: atl-run <app_id> <apk>   (app_id = the package name, e.g. com.whatsapp)
app_id=$1
apk=$2
[ -n "$app_id" ] && [ -f "$apk" ] || { echo "usage: atl-run <app_id> <apk>" >&2; exit 1; }

[ -S "$SWAYSOCK" ] || SWAYSOCK=$(ls /run/user/"$(id -u)"/sway-ipc.*.sock 2>/dev/null | head -1)
export SWAYSOCK

if swaymsg -t get_tree | grep -q "\"app_id\": \"$app_id\""; then
	swaymsg "[app_id=\"^$app_id\$\"] focus" >/dev/null
	exit 0
fi

export LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/art
export LD_PRELOAD=$HOME/.local/lib/atl/libatl-bionic-extra.so
export ATL_DISABLE_WINDOW_DECORATIONS=1
# no GPU here: GTK's GL renderer on software GL loses its glyph atlas (magenta text)
export GSK_RENDERER=cairo
log=$HOME/.cache/atl/$app_id.log
mkdir -p "${log%/*}"
/usr/local/bin/android-translation-layer "$apk" > "$log" 2>&1 &
pid=$!

# The window maps late (ART start-up), wherever focus is by then: wait for it,
# then move it to the first workspace number with no windows and follow it.
i=0
while [ $i -lt 600 ] && kill -0 $pid 2>/dev/null; do
	if swaymsg -t get_tree | grep -q "\"app_id\": \"$app_id\""; then
		used=$(swaymsg -t get_workspaces | grep -o '"num": [0-9]*' | grep -o '[0-9]*')
		n=1
		while echo "$used" | grep -qx "$n"; do n=$((n + 1)); done
		swaymsg "[app_id=\"^$app_id\$\"] move container to workspace number $n, workspace number $n" >/dev/null
		break
	fi
	sleep 0.5
	i=$((i + 1))
done
wait $pid
