#!/bin/sh
# WhatsApp under Android Translation Layer, on its own workspace. Report the
# telephony feature so WhatsApp registers as a phone, not a companion tablet.
# It stays running in the background when its window is closed, so messages
# keep arriving (atl-whatsapp --hidden = start in the background, superd
# service atl-whatsapp).
export ATL_HAS_TELEPHONY=1
export ATL_UGLY_ENABLE_CONTACTS=1
# voice calls and voice notes: ATL denies RECORD_AUDIO without this
export ATL_UGLY_ENABLE_MICROPHONE=1
export ATL_CONTACTS_DEBUG=1
export ATL_BACKGROUND=1
# WhatsApp's native code makes JNI calls with an exception pending; CheckJNI would abort
export ATL_CHECKJNI=0
exec "$HOME/.local/bin/atl-run" "$@" com.whatsapp "$HOME/apks/whatsapp.apk"
