#!/bin/sh
# Bound over Spotube's /app/bin/yt-dlp by lagos-flatpak-run (overlay). The
# bundled yt-dlp is stale and the chroot has no JS runtime, so YouTube's
# n-challenge stays unsolved and googlevideo answers 403: use a current
# yt-dlp zipapp plus the official glibc deno build, both kept in $D.
# Refresh with: spotube-yt-dlp-update
D=$HOME/.local/share/lagos-flatpak/com.github.KRTirtho.Spotube
run() { /usr/bin/python3 "$D/yt-dlp.zip" --no-update --js-runtimes "deno:$D/deno" "$@"; }
case "$*" in
*ytsearch*)
	# Spotube's YtDlpEngine._parseInfo casts id/title/channel/channel_id/duration
	# without null checks; one search hit without them (some flat results have no
	# channel_id) throws away the whole search, so drop those lines.
	run "$@" | /usr/bin/python3 -c '
import json, sys
for line in sys.stdin:
    try:
        d = json.loads(line)
    except ValueError:
        continue
    if all(isinstance(d.get(k), str) for k in ("id", "title", "channel", "channel_id")) \
            and isinstance(d.get("duration"), (int, float)):
        sys.stdout.write(line)
' ;;
*) run "$@" ;;
esac
