#!/bin/sh
# spotube-yt-dlp-update: fetch the latest yt-dlp zipapp and glibc deno
# (aarch64-unknown-linux-gnu; Alpine's deno is musl and can't run in the
# flatpak chroot) for Spotube, and install the yt-dlp overlay wrapper.
set -e
D=$HOME/.local/share/lagos-flatpak/com.github.KRTirtho.Spotube
mkdir -p "$D/overlay/app/bin"
curl -fL -o "$D/yt-dlp.zip.new" https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp
mv "$D/yt-dlp.zip.new" "$D/yt-dlp.zip"
curl -fL -o "$D/deno.zip" https://github.com/denoland/deno/releases/latest/download/deno-aarch64-unknown-linux-gnu.zip
unzip -o -q "$D/deno.zip" -d "$D"
rm "$D/deno.zip"
install -m 755 "$(dirname "$(readlink -f "$0")")/spotube-yt-dlp" "$D/overlay/app/bin/yt-dlp" 2>/dev/null ||
	install -m 755 "$HOME/.local/bin/spotube-yt-dlp" "$D/overlay/app/bin/yt-dlp"
python3 "$D/yt-dlp.zip" --version
"$D/deno" --version | head -1
