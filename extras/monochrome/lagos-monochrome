#!/usr/bin/env python3
"""Monochrome as an app: bare WebKitGTK window on the local build (http://localhost:3000).
Normal tiled window (not fullscreen) so sway shrinks it when wvkbd's exclusive zone appears;
GTK4 text-input-v3 makes wvkbd --auto show on input focus."""
import os, subprocess, sys, time, urllib.request
os.environ.setdefault("GSK_RENDERER", "cairo")
os.environ.setdefault("WEBKIT_DISABLE_SANDBOX_THIS_IS_DANGEROUS", "1")
os.environ.setdefault("WEBKIT_DISABLE_COMPOSITING_MODE", "1")
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("WebKit", "6.0")
from gi.repository import Gtk, WebKit, GLib

URL = "http://localhost:3000/"
DATA = os.path.expanduser("~/.local/share/lagos-monochrome")


def ensure_server():
    try:
        urllib.request.urlopen(URL, timeout=2).close()
        return
    except Exception:
        subprocess.run(["systemctl", "--user", "start", "monochrome.service"])
        for _ in range(20):
            time.sleep(0.5)
            try:
                urllib.request.urlopen(URL, timeout=2).close()
                return
            except Exception:
                pass


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.lagos.Monochrome")

    def do_activate(self):
        win = self.props.active_window
        if win:
            win.present()
            return
        ensure_server()
        session = WebKit.NetworkSession.new(DATA + "/data", DATA + "/cache")
        session.get_cookie_manager().set_persistent_storage(
            DATA + "/cookies.sqlite", WebKit.CookiePersistentStorage.SQLITE)
        view = WebKit.WebView(network_session=session)
        s = view.get_settings()
        s.set_hardware_acceleration_policy(WebKit.HardwareAccelerationPolicy.NEVER)
        s.set_enable_media(True)
        s.set_media_playback_requires_user_gesture(False)
        s.set_enable_mediasource(True)
        s.set_enable_developer_extras(bool(os.environ.get("LAGOS_DEBUG")))
        if os.environ.get("LAGOS_DEBUG"):
            # forward console output / errors to stderr
            ucm = view.get_user_content_manager()
            ucm.register_script_message_handler("log", None)
            ucm.connect("script-message-received::log",
                        lambda m, v: print("JS:", v.to_string(), file=sys.stderr, flush=True))
            ucm.add_script(WebKit.UserScript.new(
                "for (const k of ['log','warn','error']) { const o = console[k].bind(console);"
                " console[k] = (...a) => { try { window.webkit.messageHandlers.log.postMessage("
                "k + ': ' + a.map(x => (x && x.stack) || String(x)).join(' ')); } catch (e) {} o(...a); }; }"
                " addEventListener('error', e => console.error('onerror', e.message, e.filename, e.lineno));"
                " addEventListener('unhandledrejection', e => console.error('rejection', e.reason));",
                WebKit.UserContentInjectedFrames.ALL_FRAMES, WebKit.UserScriptInjectionTime.START, None, None))
        view.connect("web-process-terminated",
                     lambda v, reason: print("web process terminated:", reason, file=sys.stderr, flush=True))
        view.load_uri(URL)
        win = Gtk.ApplicationWindow(application=self, title="Monochrome")
        win.set_default_size(360, 720)
        win.set_child(view)
        win.present()


sys.exit(App().run(sys.argv))
