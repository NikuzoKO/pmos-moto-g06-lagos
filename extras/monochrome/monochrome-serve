#!/usr/bin/env python3
# Static server for the local Monochrome build (~/src/monochrome/dist) on 127.0.0.1:3000, SPA fallback to index.html.
import http.server, os, functools
ROOT = os.path.expanduser("~/src/monochrome/dist")
class H(http.server.SimpleHTTPRequestHandler):
    def send_head(self):
        p = self.translate_path(self.path.split("?")[0])
        if not os.path.exists(p):
            self.path = "/index.html"
        return super().send_head()
    def end_headers(self):
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()
http.server.ThreadingHTTPServer(("127.0.0.1", 3000), functools.partial(H, directory=ROOT)).serve_forever()
