+/*
+ * lagos: the MediaTek legacy gpufreq driver owns clock, buck and vsram, so
+ * mirror its working OPP table as dynamic OPPs and switch with gpufreq_commit().
+ */
+static int panfrost_devfreq_mtk_idx(unsigned long freq)
+{
+	int i, n = gpufreq_get_opp_num(0);
+
+	for (i = 0; i < n; i++)
+		if (gpufreq_get_freq_by_idx(0, i) * 1000UL == freq)
+			return i;
+	return -EINVAL;
+}
+
+static int panfrost_devfreq_mtk_target(struct device *dev, unsigned long *freq,
+				       u32 flags)
+{
+	struct dev_pm_opp *opp;
+	int idx, ret;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+
+	idx = panfrost_devfreq_mtk_idx(*freq);
+	if (idx < 0)
+		return idx;
+
+	ret = gpufreq_commit(0, idx);
+	return ret < 0 ? ret : 0;
+}
+
+static struct devfreq_dev_profile panfrost_devfreq_mtk_profile = {
+	.timer = DEVFREQ_TIMER_DELAYED,
+	.polling_ms = 50,
+	.target = panfrost_devfreq_mtk_target,
+	.get_dev_status = panfrost_devfreq_get_dev_status,
+};
+
+static void panfrost_devfreq_mtk_remove_opps(void *dev)
+{
+	dev_pm_opp_remove_all_dynamic(dev);
+}
+
+static int panfrost_devfreq_init_mtk(struct panfrost_device *pfdev)
+{
+	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
+	struct device *dev = &pfdev->pdev->dev;
+	struct devfreq *devfreq;
+	int i, n, ret;
+
+	n = gpufreq_get_opp_num(0);
+	if (n <= 0)
+		return 0;
+
+	ret = devm_add_action(dev, panfrost_devfreq_mtk_remove_opps, dev);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < n; i++) {
+		struct dev_pm_opp_data data = {
+			.freq = gpufreq_get_freq_by_idx(0, i) * 1000UL,
+		};
+
+		ret = dev_pm_opp_add_dynamic(dev, &data);
+		if (ret) {
+			DRM_DEV_ERROR(dev, "Couldn't add OPP %lu (%d)\n", data.freq, ret);
+			return ret;
+		}
+	}
+
+	spin_lock_init(&pfdevfreq->lock);
+	panfrost_devfreq_reset(pfdevfreq);
+
+	panfrost_devfreq_mtk_profile.initial_freq = gpufreq_get_cur_freq(0) * 1000UL;
+	pfdevfreq->gov_data.upthreshold = 45;
+	pfdevfreq->gov_data.downdifferential = 5;
+
+	devfreq = devm_devfreq_add_device(dev, &panfrost_devfreq_mtk_profile,
+					  DEVFREQ_GOV_SIMPLE_ONDEMAND,
+					  &pfdevfreq->gov_data);
+	if (IS_ERR(devfreq)) {
+		DRM_DEV_ERROR(dev, "Couldn't initialize GPU devfreq\n");
+		return PTR_ERR(devfreq);
+	}
+	pfdevfreq->devfreq = devfreq;
+
+	DRM_DEV_INFO(dev, "devfreq: %d MTK OPPs, %lu-%lu MHz\n", n,
+		     gpufreq_get_freq_by_idx(0, n - 1) / 1000UL,
+		     gpufreq_get_freq_by_idx(0, 0) / 1000UL);
+	return 0;
+}
