+/* Mesa/mainline name the interrupts "job", "mmu", "gpu"; MediaTek's DT uses uppercase */
+int panfrost_get_irq(struct panfrost_device *pfdev, const char *name)
+{
+	struct platform_device *pdev = to_platform_device(pfdev->dev);
+	char upper[8];
+	int irq, i;
+
+	irq = platform_get_irq_byname_optional(pdev, name);
+	if (irq > 0)
+		return irq;
+
+	for (i = 0; name[i] && i < sizeof(upper) - 1; i++)
+		upper[i] = toupper(name[i]);
+	upper[i] = 0;
+
+	return platform_get_irq_byname(pdev, upper);
+}
