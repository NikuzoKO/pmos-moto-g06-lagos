+/* lagos bring-up: breadcrumbs that survive a hard hang (logger fsyncs) */
+static int stop_stage = 99;
+module_param(stop_stage, int, 0644);
+MODULE_PARM_DESC(stop_stage, "abort probe with -ENODEV after this stage (bring-up bisect)");
+#define PF_BC(pfdev, n, what) ({ \
+	dev_dbg((pfdev)->dev, "BC%d %s\n", n, what); \
+	(n) >= stop_stage; })
+
+static int panfrost_mtk_power(struct panfrost_device *pfdev, bool on)
+{
+	int ret;
+
+	if (!pfdev->comp->mtk_gpufreq)
+		return 0;
+	dev_dbg(pfdev->dev, "mtk power %d: bringup=%u ctrl_enable=%u\n",
+		 on, gpufreq_bringup(), gpufreq_power_ctrl_enable());
+	if (gpufreq_bringup() || !gpufreq_power_ctrl_enable())
+		return 0;
+
+	ret = gpufreq_power_control(on ? 1 : 0);
+	if (ret < 0) {
+		dev_err(pfdev->dev, "gpufreq power %s failed %d\n",
+			on ? "on" : "off", ret);
+		return ret;
+	}
+	return 0;
+}
