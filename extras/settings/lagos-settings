def sw_row(title, sub, icon, active, on, sens=None):
    """Switch row; sens = confirm text makes it a flagged, confirmed change."""
    r = row(title, sub, icon)
    sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=active)
    mode = {"m": None}

    def state_set(s, st):
        if mode["m"] == "revert" or not sens:
            if mode["m"] != "revert":
                on(st)
            return False

        def ok():
            s.set_state(st)
            on(st)

        def undo():
            mode["m"] = "revert"
            s.set_active(not st)
            mode["m"] = None
        confirm(title, sens, ok, cancel=undo)
        return True
    sw.connect("state-set", state_set)
    if sens:
        flag(r)
    r.add_suffix(sw)
    r.set_activatable_widget(sw)
    r.switch = sw
    return r


def act_row(title, sub, icon, cb, sens=None, nav=False, label="Continue"):
    def go():
        if sens:
            confirm(title, sens, cb, label=label)
        else:
            cb()
    r = row(title, sub, icon, nav=nav, activate=go)
    if sens:
        flag(r)
    return r


def choice_rows(c, options, current, on_pick, sens=None):
    group = None
    for lab, val in options:
        rr = Adw.ActionRow(title=lab)
        chk = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        if group:
            chk.set_group(group)
        else:
            group = chk
        chk.set_active(val == current)
        mode = {"m": None}

        def tog(w, val=val, lab=lab, mode=mode, group=group):
            if not w.get_active() or mode["m"]:
                return
            if sens:
                prev = w
                w.set_active(False)
                confirm(lab, sens, lambda: (mode.__setitem__("m", "x"), w.set_active(True), mode.__setitem__("m", None), on_pick(val)))
            else:
                on_pick(val)
        chk.connect("toggled", tog)
        rr.add_prefix(chk)
        rr.set_activatable_widget(chk)
        if sens:
            flag(rr)
        c.append(rr)


def svc_active(name):
    return sh("systemctl", "is-active", name)[1] == "active"


def sudo_async(cmd, ok_msg=None, cb=None):
    def done(rc, out, err):
        if rc:
            toast("Failed: " + (err.splitlines()[-1] if err else f"exit {rc}"))
        elif ok_msg:
            toast(ok_msg)
        if cb:
            cb(rc, out, err)
    run_async(["sudo", "-n"] + list(cmd), done)


def read(path, default=""):
    try:
        return open(path).read().strip()
    except Exception:
        return default


def edit_kv(path, key, line):
    """Replace or append a line starting with `key` in a text file (backup once)."""
    txt = read(path)
    if txt and not os.path.exists(path + ".bak"):
        shutil.copy(path, path + ".bak")
    out, hit = [], False
    for l in txt.splitlines():
        if l.startswith(key):
            out.append(line)
            hit = True
        else:
            out.append(l)
    if not hit:
        out.append(line)
    open(path, "w").write("\n".join(out) + "\n")


# ---------------------------------------------------------------- Connections
def bluetooth_page():
    b = new_page("Bluetooth")
    powered = "Powered: yes" in sh("bluetoothctl", "show")[1]
    c = card()
    c.append(sw_row("On", None, None, powered, lambda on: run_async(["bluetoothctl", "power", "on" if on else "off"])))
    b.append(c)
    section(b, "Paired devices")
    dc = card()
    out = sh("bluetoothctl", "devices", "Paired")[1] or sh("bluetoothctl", "devices")[1]
    for l in out.splitlines():
        p = l.split(" ", 2)
        if len(p) < 3:
            continue
        mac, name = p[1], p[2]
        con = "Connected: yes" in sh("bluetoothctl", "info", mac)[1]
        dc.append(sw_row(name, "Connected" if con else "Paired", "bluetooth-symbolic", con,
                         lambda st, mac=mac: run_async(["bluetoothctl", "connect" if st else "disconnect", mac])))
    b.append(dc)
    section(b, "Visibility")
    c2 = card()
    disc = "Discoverable: yes" in sh("bluetoothctl", "show")[1]
    c2.append(sw_row("Discoverable", "Lets any nearby device see this phone", "bluetooth-symbolic", disc,
                     lambda on: run_async(["bluetoothctl", "discoverable", "on" if on else "off"]),
                     sens="Any device in range can see and try to pair with this phone while this is on."))
    b.append(c2)
    return page("Bluetooth", b)


def mobile_page():
    b = new_page("Mobile network")
    c = card()
    rc, out, _ = sh("mmcli", "-m", "any")
    info = {}
    for l in out.splitlines():
        if "|" in l:
            k, _, v = l.partition(":")
            info[k.split("|")[-1].strip()] = v.strip()
    for lab, key in (("Operator", "operator name"), ("State", "state"), ("Signal", "signal quality"),
                     ("Access technology", "access tech"), ("Number", "own")):
        if info.get(key):
            c.append(row(lab, info[key]))
    if not info:
        c.append(row("Modem not available"))
    b.append(c)
    gsm = next((l.rsplit(":", 1)[0] for l in sh("nmcli", "-t", "-f", "NAME,TYPE", "con", "show")[1].splitlines()
                if l.endswith(":gsm")), None)
    if gsm:
        section(b, "Data")
        c2 = card()
        up = sh("nmcli", "-g", "GENERAL.STATE", "con", "show", gsm)[1] == "activated"
        c2.append(sw_row("Mobile data", gsm, "network-cellular-signal-good-symbolic", up,
                         lambda on: run_async(["nmcli", "con", "up" if on else "down", gsm])))
        home_only = sh("nmcli", "-g", "gsm.home-only", "con", "show", gsm)[1] == "yes"
        c2.append(sw_row("Data roaming", "Off keeps data on the home network", "network-cellular-signal-ok-symbolic",
                         not home_only,
                         lambda on: sh("nmcli", "con", "mod", gsm, "gsm.home-only", "no" if on else "yes"),
                         sens="Roaming data can be very expensive. Turn it on only if you know your plan covers it."))
        c2.append(sw_row("Always connect", "Reconnect data automatically", "emblem-synchronizing-symbolic",
                         sh("nmcli", "-g", "connection.autoconnect", "con", "show", gsm)[1] == "yes",
                         lambda on: sh("nmcli", "con", "mod", gsm, "connection.autoconnect", "yes" if on else "no")))
        b.append(c2)
    return page("Mobile network", b)


def hotspot_page():
    b = new_page("Mobile hotspot")
    active = sh("nmcli", "-g", "GENERAL.STATE", "con", "show", "Hotspot")[1] == "activated"
