SENSITIVE_NOTE = "Sensitive setting: it can lock you out, expose the phone or break something. It asks before changing."


def toast(text):
    w = APP.props.active_window
    if w:
        w.toast.add_toast(Adw.Toast(title=text, timeout=3))


def confirm(heading, body, action, label="Continue", cancel=None):
    d = Adw.AlertDialog(heading=heading, body=body)
    d.add_response("cancel", "Cancel")
    d.add_response("ok", label)
    d.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
    d.set_default_response("cancel")

    def resp(_d, r):
        if r == "ok":
            action()
        elif cancel:
            cancel()
    d.connect("response", resp)
    d.present(APP.props.active_window)


def flag(r):
    ic = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
    ic.add_css_class("flag")
    ic.set_tooltip_text(SENSITIVE_NOTE)
    r.add_suffix(ic)
    r.sensitive_flag = True


