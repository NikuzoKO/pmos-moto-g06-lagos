def bluetooth_page(nav):
    b = vbox()
    t = Gtk.Label(label="Bluetooth", xalign=0)
    t.add_css_class("big-title")
    b.append(t)
    powered = "Powered: yes" in sh("bluetoothctl", "show")[1]
    c = card()
    r, _ = switch_row("On", None, None, "blue", powered,
                      lambda on: run_async(["bluetoothctl", "power", "on" if on else "off"]))
    c.append(r)
    b.append(c)
    section(b, "Paired devices")
    dc = card()
    out = sh("bluetoothctl", "devices", "Paired")[1] or sh("bluetoothctl", "devices")[1]
    for l in out.splitlines():
        p = l.split(" ", 2)
        if len(p) < 3:
            continue
        mac, name = p[1], p[2]
        con = "Connected: yes" in sh("bluetoothctl", "info", mac)[1]
        rr = row(name, "Connected" if con else "Paired", "bluetooth-symbolic", "blue")
        sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=con)
        sw.connect("state-set", lambda s, st, mac=mac: (run_async(["bluetoothctl", "connect" if st else "disconnect", mac]), False)[1])
        rr.add_suffix(sw)
        dc.append(rr)
    b.append(dc)
    return page("Bluetooth", b)


def volume_get(target):
    out = sh("wpctl", "get-volume", target)[1].split()
    try:
        return int(float(out[1]) * 100)
    except Exception:
        return 50


