def security_page():
    b = new_page("Lock screen and security")
    c = card()

    def change():
        d = Adw.AlertDialog(heading="Lock screen passcode", body="4 to 8 digits.")
        bx = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        a = Gtk.PasswordEntry(show_peek_icon=True)
