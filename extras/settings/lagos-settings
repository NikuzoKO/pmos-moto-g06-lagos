def read(path, default=""):
    try:
        return open(path).read().strip()
    except Exception:
        return default


def sway_scale():
    try:
        import json
        return float(json.loads(sh("swaymsg", "-t", "get_outputs", "-r")[1])[0]["scale"])
    except Exception:
        return 2.0


def display_page(nav, app):
    b = vbox()
    t = Gtk.Label(label="Display", xalign=0)
    t.add_css_class("big-title")
    b.append(t)
    c = card()
    c.append(slider_row("Brightness", "display-brightness-symbolic", "orange", 1, 100,
                        int(100 * int(read("/sys/class/leds/lcd-backlight/brightness", "128") or 128) / 255),
                        lambda v: run_async(["brightnessctl", "-q", "set", f"{v}%"])))
    b.append(c)
    c2 = card()
    dark = Adw.StyleManager.get_default().get_dark()
    r, _ = switch_row("Dark mode", "Applies to Settings and libadwaita apps", "weather-clear-night-symbolic", "purple",
                      dark, app.set_dark)
    c2.append(r)
    b.append(c2)
    section(b, "Screen zoom")
    c3 = card()
    cur = sway_scale()
    group = None
    for lab, val in (("Smaller (1.5×)", 1.5), ("Default (2×)", 2.0), ("Larger (2.5×)", 2.5)):
        rr = Adw.ActionRow(title=lab)
        chk = Gtk.CheckButton(valign=Gtk.Align.CENTER)
        if group:
            chk.set_group(group)
        else:
            group = chk
        chk.set_active(abs(cur - val) < 0.01)
        chk.connect("toggled", lambda w, v=val: w.get_active() and run_async(["swaymsg", "output", "*", "scale", str(v)]))
        rr.add_prefix(chk)
        rr.set_activatable_widget(chk)
        c3.append(rr)
    b.append(c3)
    section(b, "Orientation")
    c4 = card()
    for lab, tr in (("Portrait", "normal"), ("Landscape", "90"), ("Auto-rotate", None)):
        c4.append(row(lab, None, None, activate=(lambda tr=tr, lab=lab: run_async(
            ["swaymsg", "output", "*", "transform", tr]) if tr else
            run_async(["sh", "-c", "pgrep -f '[a]uto-rotate' >/dev/null || (command -v sxmo_rotateautotoggle.sh >/dev/null && sxmo_rotateautotoggle.sh)"]))))
    b.append(c4)
    return page("Display", b)


