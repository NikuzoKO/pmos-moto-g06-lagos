# ---------------------------------------------------------------- main window
class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.lagos.Settings")
        self.wifi = None

    def set_dark(self, on):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK if on else Adw.ColorScheme.FORCE_LIGHT)

    def do_startup(self):
        Adw.Application.do_startup(self)
        _provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(__import__("gi.repository.Gdk", fromlist=["Gdk"]).Display.get_default(),
                                                  _provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    def do_activate(self):
        if self.props.active_window:
            self.props.active_window.present()
            return
        win = Adw.ApplicationWindow(application=self, default_width=360, default_height=780)
        win.toast = Adw.ToastOverlay()
        nav = Adw.NavigationView()
        win.toast.set_child(nav)
        win.set_content(win.toast)
        self.wifi = WifiPage(nav)
        home = vbox()
        t = Gtk.Label(label="Settings", xalign=0)
        t.add_css_class("big-title")
        home.append(t)
        search = Gtk.SearchEntry(placeholder_text="Search settings")
        search.add_css_class("search-pill")
        home.append(search)
        rows = []

        def entry(box, title, sub, icon, color, target):
            r = row(title, sub, icon, color, nav=True, activate=lambda: nav.push(target() if callable(target) else target))
            box.append(r)
            rows.append(r)

        wifi_ssid = sh("nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi")[1]
        cur = next((l.split(":", 1)[1] for l in wifi_ssid.splitlines() if l.startswith("yes:")), None)
        g1 = card()
        entry(g1, "Wi-Fi", cur or ("Not connected" if self.wifi.enabled() else "Off"), "network-wireless-symbolic", "blue", self.wifi.page)
        entry(g1, "Bluetooth", None, "bluetooth-symbolic", "blue", lambda: bluetooth_page(nav))
        entry(g1, "Mobile network", None, "network-cellular-signal-good-symbolic", "green", lambda: mobile_page(nav))
        ar, asw = switch_row("Airplane mode", None, "airplane-mode-symbolic", "orange", airplane_state(),
                             lambda on: run_async(["nmcli", "radio", "all", "off" if on else "on"]))
        g1.append(ar)
        rows.append(ar)
        home.append(g1)
        g2 = card()
        entry(g2, "Sounds and vibration", None, "audio-volume-high-symbolic", "purple", lambda: sounds_page(nav))
        entry(g2, "Display", "Brightness, dark mode, zoom", "display-brightness-symbolic", "orange", lambda: display_page(nav, self))
        home.append(g2)
        g3 = card()
        entry(g3, "Battery", read("/sys/class/power_supply/battery/capacity") + "%", "battery-symbolic", "green", lambda: battery_page(nav))
        entry(g3, "Storage", None, "drive-harddisk-symbolic", "teal", lambda: storage_page(nav))
        entry(g3, "About phone", None, "phone-symbolic", "grey", lambda: about_page(nav))
        home.append(g3)

        def filt(e):
            q = e.get_text().lower()
            for r in rows:
                r.set_visible(q in r.get_title().lower())
        search.connect("search-changed", filt)
        nav.add(page("Settings", home))
        GLib.idle_add(lambda: align_start(home))
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
