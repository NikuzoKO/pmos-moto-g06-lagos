        d.add_response("cancel", "Cancel")
        d.add_response("set", "Set")
        d.set_response_appearance("set", Adw.ResponseAppearance.SUGGESTED)

        def resp(_d, r):
            if r != "set":
                return
            v = a.get_text()
            if not (v.isdigit() and 4 <= len(v) <= 8):
                return toast("Use 4 to 8 digits")
            if v != a2.get_text():
                return toast("They don't match")
            if os.path.exists(PASSCODE) and not os.path.exists(PASSCODE + ".bak"):
                shutil.copy(PASSCODE, PASSCODE + ".bak")
            open(PASSCODE, "w").write(v + "\n")
            os.chmod(PASSCODE, 0o600)
            toast("Passcode changed")
        d.connect("response", resp)
        d.present(APP.props.active_window)
    c.append(act_row("Change passcode", "Used by the lock screen", "system-lock-screen-symbolic", change,
                     sens="If you forget the new passcode you need SSH or a console to recover (file ~/.config/sxmo/peanutbutter-passcode)."))
