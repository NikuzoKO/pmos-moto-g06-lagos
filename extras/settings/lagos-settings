    t.add_css_class("big-title")
    b.append(t)
    c = card()
    c.append(slider_row("Media volume", "audio-volume-high-symbolic", "purple", 0, 100,
                        volume_get("@DEFAULT_AUDIO_SINK@"),
                        lambda v: run_async(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{v}%"])))
    c.append(slider_row("Microphone", "audio-input-microphone-symbolic", "teal", 0, 100,
