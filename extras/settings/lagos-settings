def storage_page(nav):
    b = vbox()
    t = Gtk.Label(label="Storage", xalign=0)
    t.add_css_class("big-title")
    b.append(t)
    c = card()
    for path, name in (("/", "Internal storage"), (os.path.expanduser("~"), "Home")):
        try:
            u = shutil.disk_usage(path)
        except Exception:
            continue
        gb = 1024 ** 3
        rr = row(name, f"{u.used / gb:.1f} GB used of {u.total / gb:.1f} GB", "drive-harddisk-symbolic", "teal")
        c.append(rr)
        bar = Gtk.ProgressBar(fraction=u.used / u.total, margin_start=14, margin_end=14, margin_bottom=10)
        c.append(Gtk.ListBoxRow(child=bar, activatable=False, selectable=False))
    mem = {l.split(":")[0]: int(l.split()[1]) for l in read("/proc/meminfo").splitlines() if ":" in l}
    c.append(row("Memory", f"{(mem['MemTotal'] - mem['MemAvailable']) / 1048576:.1f} GB used of {mem['MemTotal'] / 1048576:.1f} GB",
                 "computer-symbolic", "purple"))
    b.append(c)
    return page("Storage", b)


