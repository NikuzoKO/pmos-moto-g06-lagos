_provider = Gtk.CssProvider()


def sh(*cmd, timeout=15):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip(), r.stderr.strip()
    except Exception as e:
        return 1, "", str(e)


def run_async(cmd, cb=None):
    """Run cmd in a Gio subprocess; cb(rc, stdout, stderr) on the main loop."""
    p = Gio.Subprocess.new(cmd, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
    def done(proc, res):
        try:
            _, out, err = proc.communicate_utf8_finish(res)
        except GLib.Error as e:
            out, err = "", str(e)
        if cb:
            cb(proc.get_exit_status(), (out or "").strip(), (err or "").strip())
    p.communicate_utf8_async(None, None, done)


def badge(icon, color):
    b = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    b.add_css_class("badge")
    img = Gtk.Image.new_from_icon_name(icon)
    img.set_pixel_size(22)
    img.set_hexpand(True)
    b.append(img)
    p = Gtk.CssProvider()
    p.load_from_string(".b{background:%s;}" % COLORS.get(color, color))
    b.add_css_class("b")
    b.get_style_context().add_provider(p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    return b


def card():
    lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
    lb.add_css_class("card")
    lb.add_css_class("boxed-list")
    return lb


def row(title, sub=None, icon=None, color="blue", nav=False, activate=None):
    r = Adw.ActionRow(title=title, subtitle=sub or "")
    r.set_subtitle_lines(1)
    if icon:
        r.add_prefix(badge(icon, color))
    if nav:
        r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
    if activate:
        r.set_activatable(True)
        r.connect("activated", lambda *_: activate())
    return r


def align_start(w):
    """Left-align every label and keep headline margins on one edge with the card text."""
    c = w.get_first_child()
    while c:
        if isinstance(c, Gtk.Label):
            c.set_xalign(0)
            c.set_halign(Gtk.Align.START)
            c.set_justify(Gtk.Justification.LEFT)
        align_start(c)
        c = c.get_next_sibling()


def page(title, content_widget):
    align_start(content_widget)
    sc = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
    sc.set_child(content_widget)
    tv = Adw.ToolbarView()
    hb = Adw.HeaderBar()
    tv.add_top_bar(hb)
    tv.set_content(sc)
    return Adw.NavigationPage(title=title, child=tv)


def vbox():
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)


def section(box, text):
    l = Gtk.Label(label=text, xalign=0)
    l.add_css_class("sec")
    box.append(l)


def switch_row(title, sub, icon, color, active, on_toggle):
    r = row(title, sub, icon, color)
    sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=active)
    sw.connect("state-set", lambda s, st: (on_toggle(st), False)[1])
    r.add_suffix(sw)
    r.set_activatable_widget(sw)
    return r, sw


def slider_row(title, icon, color, lo, hi, val, on_change):
    r = Adw.ActionRow(title=title)
    r.add_prefix(badge(icon, color))
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    sc.set_value(val)
    sc.set_hexpand(True)
    sc.set_size_request(170, -1)
    sc.set_valign(Gtk.Align.CENTER)
    sc.connect("value-changed", lambda s: on_change(int(s.get_value())))
    r.add_suffix(sc)
    return r


# ---------------------------------------------------------------- Wi-Fi
class WifiPage:
    def __init__(self, nav):
        self.nav = nav
        self.box = vbox()
        self.page = page("Wi-Fi", self.box)
        self.page.connect("showing", lambda *_: self.refresh())
        self.refresh_id = 0
        self.build()

    def enabled(self):
        return sh("nmcli", "radio", "wifi")[1] == "enabled"

    def build(self):
        b = self.box
        t = Gtk.Label(label="Wi-Fi", xalign=0)
        t.add_css_class("big-title")
        b.append(t)
        c = card()
        r, self.sw = switch_row("On", None, None, "blue", self.enabled(), self.toggle)
        self.onrow = r
        c.append(r)
        b.append(c)
        self.cur_sec = Gtk.Label(label="Current network", xalign=0)
        self.cur_sec.add_css_class("sec")
        b.append(self.cur_sec)
        self.cur_card = card()
        b.append(self.cur_card)
        hdr = Gtk.Box(spacing=8)
        self.avail_lbl = Gtk.Label(label="Available networks", xalign=0, hexpand=True)
        self.avail_lbl.add_css_class("sec")
        self.spin = Gtk.Spinner(margin_end=20)
        hdr.append(self.avail_lbl)
        hdr.append(self.spin)
        b.append(hdr)
        self.avail_card = card()
        b.append(self.avail_card)
        sec = Gtk.Label(label="Saved networks", xalign=0)
        sec.add_css_class("sec")
        b.append(sec)
        self.saved_card = card()
        b.append(self.saved_card)
        self.rescan = Gtk.Button(label="Scan again", halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=24)
        self.rescan.add_css_class("pill")
        self.rescan.connect("clicked", lambda *_: self.refresh(True))
        b.append(self.rescan)

    def toggle(self, on):
        run_async(["nmcli", "radio", "wifi", "on" if on else "off"], lambda *_: GLib.timeout_add(1500, self.refresh_once))

    def refresh_once(self):
        self.refresh()
        return False

    @staticmethod
    def clear(lb):
        while (ch := lb.get_first_child()):
            lb.remove(ch)

    def refresh(self, rescan=False):
        on = self.enabled()
        self.sw.set_active(on)
        for w in (self.cur_sec, self.cur_card, self.avail_lbl, self.avail_card, self.rescan):
            w.set_visible(on)
        self.fill_saved()
        if not on:
            return
        self.spin.start()
        run_async(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY,BSSID", "dev", "wifi", "list",
                   "--rescan", "yes" if rescan else "auto"], self.fill_scan)

    def fill_scan(self, rc, out, err):
        self.spin.stop()
        self.clear(self.cur_card)
        self.clear(self.avail_card)
        seen = {}
        for line in out.splitlines():
            parts = line.replace("\\:", "\x00").split(":")
            if len(parts) < 4:
                continue
            use, ssid, sig, sec = parts[0], parts[1].replace("\x00", ":"), parts[2], parts[3]
            if not ssid:
                continue
            e = dict(use=use == "*", ssid=ssid, sig=int(sig or 0), sec=sec)
            old = seen.get(ssid)
            if not old or e["use"] or (not old["use"] and e["sig"] > old["sig"]):
                seen[ssid] = e
        saved = self.saved_names()
        cur = None
        for e in sorted(seen.values(), key=lambda e: -e["sig"]):
            icon = ("network-wireless-signal-excellent-symbolic" if e["sig"] > 75 else
                    "network-wireless-signal-good-symbolic" if e["sig"] > 50 else
                    "network-wireless-signal-ok-symbolic" if e["sig"] > 25 else
                    "network-wireless-signal-weak-symbolic")
            sub = ("Connected" if e["use"] else "Saved" if e["ssid"] in saved else
                   "Secured" if e["sec"] else "Open")
            r = Adw.ActionRow(title=GLib.markup_escape_text(e["ssid"]), subtitle=sub)
            r.add_prefix(Gtk.Image.new_from_icon_name(icon))
            if e["sec"]:
                r.add_suffix(Gtk.Image.new_from_icon_name("system-lock-screen-symbolic"))
            r.set_activatable(True)
            r.connect("activated", lambda _r, e=e: self.tap(e, e["ssid"] in saved))
            if e["use"]:
                r.add_css_class("conn")
                self.cur_card.append(r)
                cur = e
            else:
                self.avail_card.append(r)
        self.cur_sec.set_visible(cur is not None)
        self.cur_card.set_visible(cur is not None)

    def saved_names(self):
        rc, out, _ = sh("nmcli", "-t", "-f", "NAME,TYPE", "con", "show")
        return [l.rsplit(":", 1)[0] for l in out.splitlines() if l.endswith(":802-11-wireless")]

    def fill_saved(self):
        self.clear(self.saved_card)
        for n in self.saved_names():
            r = Adw.ActionRow(title=GLib.markup_escape_text(n))
            r.set_activatable(True)
            r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
            r.connect("activated", lambda _r, n=n: self.details(n))
            self.saved_card.append(r)

    def tap(self, e, saved):
        if e["use"]:
            return self.details(e["ssid"])
        if saved or not e["sec"]:
            self.connect(e["ssid"], None)
        else:
            self.ask_password(e["ssid"])

    def ask_password(self, ssid):
        d = Adw.AlertDialog(heading=ssid, body="Enter the Wi-Fi password")
        entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
        d.set_extra_child(entry)
        d.add_response("cancel", "Cancel")
        d.add_response("connect", "Connect")
        d.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)
        d.set_default_response("connect")
        d.connect("response", lambda _d, resp: resp == "connect" and self.connect(ssid, entry.get_text()))
        d.present(self.box.get_root())

    def toast(self, text):
        self.box.get_root().toast.add_toast(Adw.Toast(title=text, timeout=3))

    def connect(self, ssid, pw):
        self.toast(f"Connecting to {ssid}…")
        cmd = ["nmcli", "dev", "wifi", "connect", ssid] + (["password", pw] if pw else [])
        def done(rc, out, err):
            if rc:
                if pw is None:
                    sh("nmcli", "con", "delete", ssid)
                self.toast("Couldn't connect: " + (err.splitlines()[-1] if err else "failed"))
            else:
                self.toast(f"Connected to {ssid}")
            self.refresh()
        run_async(cmd, done)

    def details(self, name):
        b = vbox()
        t = Gtk.Label(label=name, xalign=0, wrap=True)
        t.add_css_class("big-title")
        b.append(t)
        rc, out, _ = sh("nmcli", "-t", "-f", "GENERAL.STATE,IP4.ADDRESS,IP4.GATEWAY,IP4.DNS,GENERAL.DEVICES", "con", "show", name)
        info = {}
        for l in out.splitlines():
            k, _, v = l.partition(":")
            info.setdefault(k.split("[")[0], v)
        active = "activated" in info.get("GENERAL.STATE", "")
        c = card()
        for lab, key in (("IP address", "IP4.ADDRESS"), ("Gateway", "IP4.GATEWAY"), ("DNS", "IP4.DNS")):
            if info.get(key):
                c.append(row(lab, info[key]))
        if not active:
            c.append(row("Not connected"))
        b.append(c)
        c2 = card()
        ar = row("Auto reconnect", None)
        auto = sh("nmcli", "-g", "connection.autoconnect", "con", "show", name)[1] == "yes"
        sw = Gtk.Switch(valign=Gtk.Align.CENTER, active=auto)
        sw.connect("state-set", lambda s, st: (sh("nmcli", "con", "mod", name, "connection.autoconnect", "yes" if st else "no"), False)[1])
        ar.add_suffix(sw)
        ar.set_activatable_widget(sw)
        c2.append(ar)
        b.append(c2)
        c3 = card()
        if active:
            c3.append(row("Disconnect", activate=lambda: (sh("nmcli", "con", "down", name), self.nav.pop(), self.refresh())))
        else:
            c3.append(row("Connect", activate=lambda: (self.nav.pop(), self.connect(name, None))))
        fr = row("Forget network", activate=lambda: (sh("nmcli", "con", "delete", name), self.nav.pop(), self.refresh()))
        fr.add_css_class("error")
        c3.append(fr)
        b.append(c3)
        self.nav.push(page(name, b))


