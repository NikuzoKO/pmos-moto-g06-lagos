    zones = sh("timedatectl", "list-timezones")[1].splitlines()

    def fill(*_):
        while (ch := lst.get_first_child()):
            lst.remove(ch)
        q = entry.get_text().lower().replace(" ", "_")
        hits = [z for z in zones if q in z.lower()][:25] if q else [cur]
        for z in hits:
            lst.append(act_row(z, "Current" if z == cur else None, "mark-location-symbolic",
                               lambda z=z: sudo_async(["timedatectl", "set-timezone", z], f"Time zone: {z}")))
        align_start(lst)
    entry.connect("changed", fill)
    fill()
    return page("Date and time", b)


def general_page():
    b = new_page("General management")
    c = card()
    c.append(act_row("Date and time", sh("date", "+%H:%M")[1], "preferences-system-time-symbolic", lambda: NAV.push(timezone_page()), nav=True))
    lang = os.environ.get("LANG", "en_US.UTF-8")
    c.append(row("Language", lang, "preferences-desktop-locale-symbolic"))

    def rename():
        d = Adw.AlertDialog(heading="Device name", body="Letters, digits and dashes.")
        e = Gtk.Entry(text=sh("hostname")[1])
        d.set_extra_child(e)
        d.add_response("cancel", "Cancel")
        d.add_response("set", "Rename")
        d.set_response_appearance("set", Adw.ResponseAppearance.SUGGESTED)

        def resp(_d, r):
            n = e.get_text().strip()
            if r == "set" and n and all(ch.isalnum() or ch == "-" for ch in n):
                sudo_async(["hostnamectl", "set-hostname", n], f"Renamed to {n}")
            elif r == "set":
                toast("Letters, digits, dashes only")
        d.connect("response", resp)
        d.present(APP.props.active_window)
    c.append(act_row("Device name", sh("hostname")[1], "computer-symbolic", rename,
                     sens="Other apps, SSH known-hosts and your network use this name. Some services need a restart to see it."))
    b.append(c)
    section(b, "Reset")
    c2 = card()
    c2.append(act_row("Reset Wi-Fi networks", "Forget every saved Wi-Fi network", "view-refresh-symbolic",
                      lambda: (sh("sh", "-c", "nmcli -t -f NAME,TYPE con show | grep ':802-11-wireless$' | cut -d: -f1 | while read n; do nmcli con delete \"$n\"; done"),
                               toast("Saved Wi-Fi networks removed")),
                      sens="Deletes all saved Wi-Fi networks and passwords. You will need to type them again.", label="Reset"))
    c2.append(act_row("Reset display zoom", None, "view-refresh-symbolic", lambda: run_async(["swaymsg", "output", "*", "scale", "2"])))
    b.append(c2)
    return page("General management", b)


# ---------------------------------------------------------------- Developer options
CORE_SERVICES = {"lagos-navbar", "lagos-statusbar", "lagos-launcher", "bonsaid", "lagos-kiosk-tile", "lagos-touchscroll", "lagos-keyboard"}


def services_page():
    b = new_page("Services")
    b.append(note("Start or stop session services. Core UI services are flagged."))
    c = card()
    import re
    for l in sh("superctl", "status")[1].splitlines()[1:]:
        l = re.sub(r"\x1b\[[0-9;]*m", "", l)
        p = l.split()
        if len(p) < 2:
            continue
        name, st = p[0], p[1]
        core = name in CORE_SERVICES
        c.append(sw_row(name, st, "applications-system-symbolic", st == "started",
                        lambda on, name=name: run_async(["superctl", "start" if on else "stop", name]),
                        sens=("Core part of the phone UI. Stopping it can leave you without a navigation bar, status bar or launcher until restart." if core else None)))
    b.append(c)
    return page("Services", b)


def kernel_log_page():
    b = new_page("Kernel log")
    tv = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR, margin_start=14, margin_end=14)
    rc, out, err = sh("sudo", "-n", "dmesg", "--time-format", "reltime", timeout=20)
    lines = [l for l in out.splitlines() if "wlan" not in l and "sensorHub" not in l][-150:]
    tv.get_buffer().set_text("\n".join(lines) or err)
    b.append(tv)
    return page("Kernel log", b)


def developer_page():
    b = new_page("Developer options")
    b.append(note("Flagged rows can break the UI or expose the phone. Each asks first."))
    c = card()
    c.append(act_row("Services", None, "applications-system-symbolic", lambda: NAV.push(services_page()), nav=True))
    c.append(act_row("Kernel log", None, "utilities-terminal-symbolic", lambda: NAV.push(kernel_log_page()), nav=True))
    c.append(sw_row("SSH server", "Remote shell on port 22", "network-server-symbolic", svc_active("sshd"),
                    lambda on: sudo_async(["systemctl", "enable" if on else "disable", "--now", "sshd"]),
                    sens="Anyone on your network who knows a password or key can get a shell on this phone."))
    b.append(c)
    section(b, "Session")
    c2 = card()
    c2.append(act_row("Reload UI config", "swaymsg reload", "view-refresh-symbolic", lambda: (sh("swaymsg", "reload"), toast("Reloaded")),
                      sens="Reloads the sway config. Windows stay, but bars and keybindings are re-applied and may flicker."))
    c2.append(act_row("Open terminal", None, "utilities-terminal-symbolic", lambda: run_async(["sh", "-c", "swaymsg exec kitty"])))
    b.append(c2)
    return page("Developer options", b)


# ---------------------------------------------------------------- About / power
def about_page():
    b = new_page("About phone")
    os_rel = {}
    for l in read("/etc/os-release").splitlines():
        if "=" in l:
            k, v = l.split("=", 1)
            os_rel[k] = v.strip('"')
    c = card()
    for lab, val in (("Device name", sh("hostname")[1]),
                     ("Model", "Motorola Moto G06 (lagos)"),
                     ("Operating system", os_rel.get("PRETTY_NAME", "postmarketOS")),
                     ("Kernel", sh("uname", "-r")[1]),
                     ("CPU", f"{os.cpu_count()} cores, {read('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor')}"),
                     ("Wi-Fi MAC", read("/sys/class/net/wlan0/address")),
                     ("Bluetooth address", (sh("bluetoothctl", "show")[1].split("\n")[0].split() or ["", "", ""])[1]),
                     ("Uptime", sh("uptime", "-p")[1] or read("/proc/uptime").split()[0] + " s")):
        c.append(row(lab, val))
    b.append(c)
    return page("About phone", b)


def airplane_state():
    return sh("nmcli", "radio", "all")[1].count("disabled") >= 2


def power_actions(box, rows):
    c = card()
    for title, icon, cmd, body in (("Restart", "system-reboot-symbolic", ["systemctl", "reboot"], "The phone reboots now. Unsaved work in open apps is lost."),
                                   ("Power off", "system-shutdown-symbolic", ["systemctl", "poweroff"], "The phone shuts down. Hold the power key to start it again.")):
        r = act_row(title, None, icon, lambda cmd=cmd: sudo_async(cmd), sens=body, label=title)
        c.append(r)
        rows.append(r)
    box.append(c)


# ---------------------------------------------------------------- main window
class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.lagos.Settings")
        self.wifi = None
        self.nav = None
        self.pages = {}

    def set_dark(self, on):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    def do_startup(self):
        Adw.Application.do_startup(self)
        _provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(__import__("gi.repository.Gdk", fromlist=["Gdk"]).Display.get_default(),
                                                  _provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)

    def do_activate(self):
        global APP, NAV
        if self.props.active_window:
            self.props.active_window.present()
            return
        APP = self
        win = Adw.ApplicationWindow(application=self, default_width=360, default_height=780)
        win.toast = Adw.ToastOverlay()
        nav = Adw.NavigationView()
        NAV = nav
        win.toast.set_child(nav)
        win.set_content(win.toast)
        self.wifi = WifiPage(nav)
        home = vbox()
        home.append(title_label("Settings"))
        search = Gtk.Entry(placeholder_text="Search settings", primary_icon_name="system-search-symbolic")
        search.add_css_class("search-pill")
        search.set_hexpand(True)
        home.append(search)
        rows = []
        self.pages = {"wifi": self.wifi.page, "bluetooth": bluetooth_page, "sounds": sounds_page, "display": display_page,
                      "battery": battery_page, "storage": storage_page, "about": about_page, "mobile": mobile_page,
                      "hotspot": hotspot_page, "connections": connections_page, "notifications": notifications_page,
                      "accessibility": accessibility_page, "security": security_page, "privacy": privacy_page,
                      "apps": apps_page, "update": update_page, "general": general_page, "developer": developer_page,
                      "time": timezone_page, "services": services_page, "kernel": kernel_log_page}

        def push(target):
            nav.push(target() if callable(target) else target)

        def hub(title, sub, icon, items, kw=""):
            """Home row that opens a page listing its member settings. items = (title, sub, icon, target, kw, flagged) or a ready row factory."""
            def build():
                b = new_page(title)
                c = card()
                for it in items:
                    if callable(it):
                        c.append(it())
                        continue
                    t, s_, ic, tg, _kw, fl = it
                    r = row(t, s_, ic, activate=lambda tg=tg: push(tg))
                    if fl:
                        flag(r)
                    r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
                    c.append(r)
                b.append(c)
                return page(title, b)
            r = row(title, sub, icon, activate=lambda: nav.push(build()))
            if any(not callable(i) and i[5] for i in items):
                flag(r)
            r.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
            names = " ".join(i[0] + " " + (i[1] or "") + " " + i[4] for i in items if not callable(i))
            r.kw = (kw + " " + names).lower()
            home_card.append(r)
            rows.append(r)
            self.pages["hub-" + title.lower().split()[0]] = build

        cur = next((l.split(":", 1)[1] for l in sh("nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi")[1].splitlines() if l.startswith("yes:")), None)
        wifi_sub = cur or ("Not connected" if self.wifi.enabled() else "Off")
        home_card = card()
        airplane = lambda: sw_row("Airplane mode", None, "airplane-mode-symbolic", airplane_state(),
                                  lambda on: run_async(["nmcli", "radio", "all", "off" if on else "on"]))
        hub("Connections", f"Wi-Fi, Bluetooth, mobile network", "network-wireless-symbolic", [
            ("Wi-Fi", wifi_sub, "network-wireless-symbolic", self.wifi.page, "wifi network wlan internet", False),
            ("Bluetooth", None, "bluetooth-symbolic", bluetooth_page, "bluetooth pair discoverable", True),
            ("Mobile network", None, "network-cellular-signal-good-symbolic", mobile_page, "sim data roaming apn cellular", True),
            airplane,
            ("Mobile hotspot", "Share data over Wi-Fi", "network-wireless-hotspot-symbolic", hotspot_page, "tethering hotspot ap", True),
            ("More connection settings", "DNS, VPN, SSH, firewall", "network-server-symbolic", connections_page,
             "dns vpn mac random ssh firewall nft private", True)], "airplane flight radio")
        hub("Sounds and display", "Volume, notifications, brightness", "audio-volume-high-symbolic", [
            ("Sounds and vibration", None, "audio-volume-high-symbolic", sounds_page, "volume mute speaker microphone vibration output", False),
            ("Notifications", "Do not disturb", "notifications-symbolic", notifications_page, "dnd history dunst", False),
            ("Display", "Brightness, timeout, zoom, wallpaper", "display-brightness-symbolic", display_page,
             "brightness dark mode zoom scale rotate orientation timeout wallpaper background", False),
            ("Accessibility", "Text size, animations", "preferences-desktop-accessibility-symbolic", accessibility_page, "font text size animation", False)])
        hub("Security and privacy", "Lock screen, location, clear data", "system-lock-screen-symbolic", [
            ("Lock screen and security", None, "system-lock-screen-symbolic", security_page, "passcode pin lock sudo", True),
            ("Privacy", "Location, clear data", "preferences-system-privacy-symbolic", privacy_page, "location clipboard clear discoverable", True)])
        hub("Device care", "Apps, battery, storage, updates", "battery-symbolic", [
            ("Apps", None, "view-app-grid-symbolic", apps_page, "applications launcher", False),
            ("Battery", read("/sys/class/power_supply/battery/capacity") + "%", "battery-symbolic", battery_page, "power governor cpu performance", True),
            ("Storage", None, "drive-harddisk-symbolic", storage_page, "disk memory swap zram cache trash", True),
            ("Software update", None, "software-update-available-symbolic", update_page, "apk upgrade packages", True)])
        hub("System", "Date and time, developer options, about", "preferences-system-symbolic", [
            ("General management", "Date and time, name, reset", "preferences-system-symbolic", general_page, "time zone ntp hostname reset language", True),
            ("Developer options", "Services, kernel log, SSH", "utilities-terminal-symbolic", developer_page, "ssh services kernel log dmesg debug", True),
            ("About phone", None, "phone-symbolic", about_page, "model kernel version mac", False)])
        home.append(home_card)
        power_actions(home, rows)
        home.append(note("The warning symbol marks sensitive settings. They ask for confirmation before they change anything."))

        def filt(e):
            q = e.get_text().lower()
            for r in rows:
                r.set_visible(q in r.get_title().lower() or q in (r.get_subtitle() or "").lower() or q in getattr(r, "kw", "")
                              or (q in "sensitive flagged warning" and getattr(r, "sensitive_flag", False)))
        search.connect("changed", filt)
        nav.add(page("Settings", home))
        GLib.idle_add(lambda: align_start(home))
        win.present()
        # debug: grim is black under sway's gles2 renderer, so render ourselves.
        # kill -USR1 <pid> -> $XDG_RUNTIME_DIR/lagos-settings.png; LAGOS_SETTINGS_PAGE=<key> opens a page at start;
        # kill -USR2 <pid> pops back one page.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 10, self.self_shot)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, 12, lambda: (nav.pop(), True)[1])
        start = os.environ.get("LAGOS_SETTINGS_PAGE")
        if start in self.pages:
            t = self.pages[start]
            nav.push(t() if callable(t) else t)

    def self_shot(self):
        win = self.props.active_window
        w, h = win.get_width(), win.get_height()
        pt = Gtk.WidgetPaintable.new(win)
        snap = Gtk.Snapshot()
        pt.snapshot(snap, w, h)
        tex = win.get_native().get_renderer().render_texture(snap.to_node(), None)
        out = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "lagos-settings.png")
        tex.save_to_png(out)
        return True


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
