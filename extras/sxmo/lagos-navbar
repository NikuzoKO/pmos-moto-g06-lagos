#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# Android-style 3-button navigation bar for sxmo on sway, as a layer-shell
# surface along the bottom edge (it reserves its height, so windows tile above
# it). Works for every app, not only Android ones:
#   back     sends Escape to the focused window (ATL maps an unconsumed Escape
#            to Activity.onBackPressed; native apps close dialogs/menus with it)
#   home     minimizes every window (sway has no minimize: they go to the
#            scratchpad, tiled ones marked so they tile again on restore);
#            pressed again on the empty desktop it opens the sxmo app menu,
#            which is the closest thing to a launcher
#   recents  full-screen card list of open windows, most recent first,
#            minimized ones included; tap a card to switch to it (a minimized
#            one comes back onto the current workspace), x to close it,
#            "Clear all" closes them all
#   keyboard (bottom right, only while wvkbd is up) hides the keyboard. No
#            polling: an invisible 1px-wide layer surface spans the usable
#            height, and sway reconfigures it when wvkbd's exclusive zone
#            comes or goes
# Started from ~/.config/services/lagos-navbar.service (superd).

import json
import math
import os
import subprocess

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, GtkLayerShell, Pango  # noqa: E402

# Logical pixels (sway scales them)
BAR_HEIGHT = 40
ISLAND_MARGIN = 3  # the bar is one pill, this far from the bottom edge
# Same estimate as lagos-statusbar: Android's rounded_corner_radius lived in the
# product partition's overlay, which is gone from this phone
SCREEN_CORNER_RADIUS = 20
CORNER_CLEARANCE = 1.5
ICON_SIZE = 16
RIPPLE_RADIUS = 20
CARD_HEIGHT = 64
SCRATCHPAD = "__i3_scratch"
TILED_MARK = "_lagos_tiled"  # sway never draws marks that start with "_"
CARD_RADIUS = 14
CARD_SPACING = 10
SIDE_MARGIN = 14
APP_ICON_SIZE = 36
HAPTIC_MS = 12
KEYBOARD_MIN_HEIGHT = 100  # logical px the usable area must lose to count as a keyboard
RIPPLE_MS = 250

# Rosé Pine, matching the desktop and the volume overlay
BAR_COLOR = (0.098, 0.090, 0.141, 1.0)  # base
ICON_COLOR = (0.878, 0.871, 0.957, 1.0)  # text
RIPPLE_COLOR = (0.878, 0.871, 0.957, 0.18)
SCRIM_COLOR = (0.098, 0.090, 0.141, 0.92)
CARD_COLOR = (0.149, 0.137, 0.227, 1.0)  # surface
CARD_PRESSED_COLOR = (0.251, 0.239, 0.322, 1.0)  # highlight med
SUBTLE_COLOR = (0.565, 0.549, 0.667, 1.0)  # subtle
ACCENT_COLOR = (0.769, 0.655, 0.906, 1.0)  # iris

APP_DIRS = [
    os.path.expanduser("~/.local/share/applications"),
    os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
    "/usr/local/share/applications",
    "/usr/share/applications",
]


def run(*args):
    subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def haptic():
    run("lagos-vibrate", str(HAPTIC_MS))


def sway(command):
    run("swaymsg", command)


def sway_json(kind):
    try:
        return json.loads(subprocess.run(["swaymsg", "-r", "-t", kind], capture_output=True, text=True, timeout=3).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


class KeyboardProbe(Gtk.Window):
    """Invisible, click-through layer surface anchored top/bottom/left, 1px wide,
    exclusive zone 0: sway sizes it to the usable height (all exclusive zones,
    wvkbd's included), so every keyboard show/hide arrives as a configure."""

    def __init__(self, on_change):
        super().__init__()
        self.on_change = on_change
        self.visible_state = None
        GtkLayerShell.init_for_window(self)
        # OVERLAY, not BOTTOM: behind windows sway sends no frame callbacks and GTK
        # never applies the new size. Zone-0 surfaces are sized after every
        # exclusive zone on any layer, so wvkbd's is still subtracted.
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(self, "lagos-keyboard-probe")
        self.set_size_request(1, 1)
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.connect("draw", self.on_draw)
        self.connect("realize", lambda *_: self.input_shape_combine_region(cairo.Region()))
        self.connect("size-allocate", self.on_size)

    def on_draw(self, widget, context):
        context.set_operator(cairo.OPERATOR_SOURCE)
        context.set_source_rgba(0, 0, 0, 0)
        context.paint()
        return True

    def on_size(self, widget, allocation):
        if allocation.height <= 1:  # before the first configure
            return
        monitor = self.get_display().get_monitor_at_window(self.get_window()) if self.get_window() else None
        if monitor is None:
            return
        full = monitor.get_geometry().height
        visible = allocation.height < full - BAR_HEIGHT - KEYBOARD_MIN_HEIGHT
        if visible != self.visible_state:
            self.visible_state = visible
            self.on_change(visible)


def rgba(context, color):
    context.set_source_rgba(*color)


def corner_inset(edge_margin, height):
    """How far from the side a pill (radius height/2) edge_margin away from the
    top/bottom edge must start to stay inside the screen's rounded corner."""
    radius = height / 2
    corner = SCREEN_CORNER_RADIUS
    allowed = corner - radius - CORNER_CLEARANCE
    dy = corner - (edge_margin + radius)
    if allowed <= 0:
        return corner
    if dy <= 0:
        return max(CORNER_CLEARANCE, corner - allowed - radius)
    if dy >= allowed:
        return corner - radius
    return max(0.0, corner - math.sqrt(allowed ** 2 - dy ** 2) - radius)


def rounded_rectangle(context, x, y, width, height, radius):
    radius = min(radius, width / 2, height / 2)
    context.new_sub_path()
    context.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
    context.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
    context.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
    context.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    context.close_path()


# --- window list ------------------------------------------------------------

def windows_most_recent_first():
    """Views from the sway tree, walked in each container's focus order (MRU)."""
    tree = sway_json("get_tree")
    if not tree:
        return []
    found = []

    def walk(node, workspace):
        if node.get("type") == "workspace":
            workspace = node.get("name")
        children = {child["id"]: child for child in node.get("nodes", []) + node.get("floating_nodes", [])}
        ordered = [children.pop(i) for i in node.get("focus", []) if i in children] + list(children.values())
        if not ordered and node.get("type") in ("con", "floating_con") and node.get("pid"):
            found.append({
                "id": node["id"],
                "app_id": node.get("app_id") or (node.get("window_properties") or {}).get("class") or "",
                "title": node.get("name") or "",
                "workspace": workspace,
                "floating": node.get("type") == "floating_con",
                "marks": node.get("marks") or [],
            })
        for child in ordered:
            walk(child, workspace)

    walk(tree, None)
    return found


_desktop_cache = {}


def desktop_entry(app_id):
    """(name, icon) for an app_id from its .desktop file, if there is one."""
    if app_id in _desktop_cache:
        return _desktop_cache[app_id]
    result = (None, None)
    candidates = []
    for directory in APP_DIRS:
        try:
            names = os.listdir(directory)
        except OSError:
            continue
        for name in names:
            if name.endswith(".desktop"):
                candidates.append(os.path.join(directory, name))
    lowered = app_id.lower()
    # exact file name first, then StartupWMClass
    candidates.sort(key=lambda path: os.path.basename(path)[:-8].lower() != lowered)
    for path in candidates:
        base = os.path.basename(path)[:-8].lower()
        try:
            with open(path, encoding="utf-8", errors="replace") as handle:
                text = handle.read()
        except OSError:
            continue
        fields = {}
        in_entry = False
        for line in text.splitlines():
            if line.startswith("["):
                in_entry = line.strip() == "[Desktop Entry]"
            elif in_entry and "=" in line:
                key, value = line.split("=", 1)
                fields.setdefault(key.strip(), value.strip())
        if base == lowered or fields.get("StartupWMClass", "").lower() == lowered:
            result = (fields.get("Name"), fields.get("Icon"))
            break
    _desktop_cache[app_id] = result
    return result


def app_icon(icon_name, app_id):
    theme = Gtk.IconTheme.get_default()
    for name in (icon_name, app_id, app_id.lower(), "application-x-executable"):
        if not name:
            continue
        try:
            if os.path.isabs(name):
                return GdkPixbuf.Pixbuf.new_from_file_at_size(name, APP_ICON_SIZE, APP_ICON_SIZE)
            if theme.has_icon(name):
                return theme.load_icon(name, APP_ICON_SIZE, Gtk.IconLookupFlags.FORCE_SIZE)
        except GLib.Error:
            continue
    return None



