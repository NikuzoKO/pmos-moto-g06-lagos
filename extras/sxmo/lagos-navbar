class Ripple:
    """A press highlight that fades out, drawn behind a button's glyph."""

    def __init__(self, widget):
        self.widget = widget
        self.start = None
        self.held = False

    def press(self):
        self.held = True
        self.start = None
        self.widget.queue_draw()

    def release(self):
        self.held = False
        self.start = GLib.get_monotonic_time()
        self.widget.add_tick_callback(self._tick)

    def _tick(self, widget, clock):
        widget.queue_draw()
        return self.alpha() > 0

    def alpha(self):
        if self.held:
            return 1.0
        if self.start is None:
            return 0.0
        progress = (GLib.get_monotonic_time() - self.start) / 1000 / RIPPLE_MS
        return max(0.0, 1.0 - progress)


class NavButton(Gtk.DrawingArea):
    def __init__(self, glyph, on_tap):
        super().__init__()
        self.glyph = glyph
        self.on_tap = on_tap
        self.ripple = Ripple(self)
        self.inside = False
        self.enabled = True
        self.set_hexpand(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)

    def set_enabled(self, enabled):
        if enabled != self.enabled:
            self.enabled = enabled
            self.queue_draw()

    def on_press(self, widget, event):
        if event.button != 1 or not self.enabled:
            return False
        self.inside = True
        self.ripple.press()
        haptic()
        return True

    def on_release(self, widget, event):
        if event.button != 1 or not self.enabled:
            return False
        allocation = self.get_allocation()
        inside = 0 <= event.x <= allocation.width and 0 <= event.y <= allocation.height
        self.ripple.release()
        if inside:
            self.on_tap()
        return True

    def on_draw(self, widget, context):
        width = self.get_allocated_width()
        height = self.get_allocated_height()
        cx, cy = width / 2, height / 2
        if not self.enabled:
            return True
        alpha = self.ripple.alpha()
        if alpha > 0:
            context.set_source_rgba(*RIPPLE_COLOR[:3], RIPPLE_COLOR[3] * alpha)
            context.arc(cx, cy, RIPPLE_RADIUS, 0, 2 * math.pi)
            context.fill()
        rgba(context, ICON_COLOR)
        context.set_line_width(1.8)
        context.set_line_join(cairo.LINE_JOIN_ROUND)
        half = ICON_SIZE / 2
        if self.glyph == "back":
            context.move_to(cx + half * 0.75, cy - half)
            context.line_to(cx - half * 0.85, cy)
            context.line_to(cx + half * 0.75, cy + half)
            context.close_path()
            context.stroke()
        elif self.glyph == "home":
            context.arc(cx, cy, half, 0, 2 * math.pi)
            context.stroke()
        elif self.glyph == "keyboard":
            # a keyboard with a down chevron under it, like Android's IME switcher slot
            top = cy - half
            rounded_rectangle(context, cx - half, top, half * 2, half * 1.15, 2)
            context.stroke()
            context.set_line_width(1.4)
            for row, count in ((0.35, 4), (0.75, 4)):
                y = top + half * 1.15 * row
                for i in range(count):
                    x = cx - half * 0.6 + i * half * 0.4
                    context.move_to(x, y)
                    context.line_to(x + 0.01, y)
            context.set_line_cap(cairo.LINE_CAP_ROUND)
            context.set_line_width(1.8)
            context.stroke()
            context.move_to(cx - half * 0.45, cy + half * 0.55)
            context.line_to(cx, cy + half * 0.95)
            context.line_to(cx + half * 0.45, cy + half * 0.55)
            context.stroke()
        else:
            rounded_rectangle(context, cx - half * 0.85, cy - half * 0.85, half * 1.7, half * 1.7, 3)
            context.stroke()
        return True


class NavBar(Gtk.Window):
    def __init__(self, recents):
        super().__init__()
        self.recents = recents
        GtkLayerShell.init_for_window(self)
        # OVERLAY: sway arranges it before TOP (wvkbd), so the bar takes the bottom edge and the keyboard sits above it
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.auto_exclusive_zone_enable(self)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(self, "lagos-navbar")
        self.set_size_request(-1, BAR_HEIGHT)
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.connect("draw", self.on_draw)

        # seven equal slots: back, home and recents two slots apart (at ~21%,
        # 50%, 79% of the width), the keyboard button in the last one
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        box.set_homogeneous(True)
        self.keyboard_button = NavButton("keyboard", self.hide_keyboard)
        self.keyboard_button.set_enabled(False)
        for child in (Gtk.Box(), NavButton("back", self.back), Gtk.Box(), NavButton("home", self.home),
                      Gtk.Box(), NavButton("recents", self.toggle_recents), self.keyboard_button):
            box.pack_start(child, True, True, 0)
        self.add(box)

        self.probe = KeyboardProbe(self.keyboard_button.set_enabled)
        self.probe.show_all()

    def hide_keyboard(self):
        run("sxmo_keyboard.sh", "close")
        self.keyboard_button.set_enabled(False)

    def on_draw(self, widget, context):
        context.set_operator(cairo.OPERATOR_SOURCE)
        context.set_source_rgba(0, 0, 0, 0)
        context.paint()
        context.set_operator(cairo.OPERATOR_OVER)
        height = BAR_HEIGHT - 2 * ISLAND_MARGIN
        inset = max(ISLAND_MARGIN, corner_inset(ISLAND_MARGIN, height))
        rounded_rectangle(context, inset, ISLAND_MARGIN, self.get_allocated_width() - 2 * inset, height, height / 2)
        rgba(context, BAR_COLOR)
        context.fill()
        return False

    def back(self):
        if self.recents.get_visible():
            self.recents.dismiss()
            return
        run("wtype", "-k", "Escape")

    def home(self):
        self.recents.dismiss()
        shown = [w for w in windows_most_recent_first() if w["workspace"] != SCRATCHPAD]
        if not shown:
            run("sxmo_appmenu.sh")
            return
        commands = []
        for window in shown:
            criteria = f"[con_id={window['id']}]"
            if not window["floating"]:
                commands.append(f"{criteria} mark --add {TILED_MARK}")
            commands.append(f"{criteria} move scratchpad")
        sway("; ".join(commands))

    def toggle_recents(self):
        if self.recents.get_visible():
            self.recents.dismiss()
        else:
            self.recents.present_list()


class Card(Gtk.EventBox):
    def __init__(self, window, recents):
        super().__init__()
        self.window = window
        self.recents = recents
        self.pressed = False
        self.set_size_request(-1, CARD_HEIGHT)
        self.set_visible_window(False)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)

        name, icon_name = desktop_entry(window["app_id"])
        name = name or window["app_id"] or "Window"
        title = window["title"] if window["title"] and window["title"] != name else ""

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_margin_start(14)
        row.set_margin_end(4)
        pixbuf = app_icon(icon_name, window["app_id"])
        image = Gtk.Image.new_from_pixbuf(pixbuf) if pixbuf else Gtk.Image()
        image.set_size_request(APP_ICON_SIZE, APP_ICON_SIZE)
        row.pack_start(image, False, False, 0)

        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        labels.set_valign(Gtk.Align.CENTER)
        name_label = Gtk.Label(xalign=0)
        name_label.set_markup(f"<b>{GLib.markup_escape_text(name)}</b>")
        name_label.set_ellipsize(Pango.EllipsizeMode.END)
        labels.pack_start(name_label, False, False, 0)
        subtitle = title
        if window["workspace"] == SCRATCHPAD:
            subtitle = f"{title}  ·  minimized" if title else "minimized"
        elif window["workspace"]:
            subtitle = f"{title}  ·  ws {window['workspace']}" if title else f"ws {window['workspace']}"
        sub_label = Gtk.Label(label=subtitle, xalign=0)
        sub_label.set_ellipsize(Pango.EllipsizeMode.END)
        sub_label.get_style_context().add_class("subtitle")
        labels.pack_start(sub_label, False, False, 0)
        row.pack_start(labels, True, True, 0)

        close = Gtk.Button(label="✕")
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.set_size_request(CARD_HEIGHT - 8, CARD_HEIGHT - 8)
        close.set_valign(Gtk.Align.CENTER)
        close.get_style_context().add_class("close")
        close.connect("clicked", self.on_close)
        row.pack_end(close, False, False, 0)
        self.add(row)
        self.connect("draw", self.on_draw)

    def on_draw(self, widget, context):
        rounded_rectangle(context, 0, 0, self.get_allocated_width(), self.get_allocated_height(), CARD_RADIUS)
        rgba(context, CARD_PRESSED_COLOR if self.pressed else CARD_COLOR)
        context.fill()
        return False

    def on_press(self, widget, event):
        if event.button == 1:
            self.pressed = True
            self.queue_draw()
        return True

    def on_release(self, widget, event):
        if event.button != 1:
            return True
        self.pressed = False
        self.queue_draw()
        allocation = self.get_allocation()
        if 0 <= event.x <= allocation.width and 0 <= event.y <= allocation.height:
            haptic()
            criteria = f"[con_id={self.window['id']}]"
            if TILED_MARK in self.window["marks"]:
                # focus pulls a scratchpad window out as floating; tile it again
                sway(f"{criteria} focus; {criteria} floating disable; {criteria} unmark {TILED_MARK}")
            else:
                sway(f"{criteria} focus")
            self.recents.dismiss()
        return True

    def on_close(self, button):
        haptic()
        sway(f"[con_id={self.window['id']}] kill")
        self.recents.remove_card(self)


class Recents(Gtk.Window):
    def __init__(self):
        super().__init__()
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        # exclusive zone 0: stays above the nav bar's reserved strip, so the bar remains usable
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(self, "lagos-recents")
        self.set_app_paintable(True)
        self.connect("draw", self.on_draw)

        outer = Gtk.EventBox()
        outer.set_visible_window(False)
        outer.connect("button-release-event", lambda *_: self.dismiss() or True)
        self.add(outer)

        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.add(layout)
        header = Gtk.Label(label="Recent", xalign=0)
        header.get_style_context().add_class("header")
        header.set_margin_start(SIDE_MARGIN + 4)
        header.set_margin_top(18)
        header.set_margin_bottom(10)
        layout.pack_start(header, False, False, 0)

        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroller.set_kinetic_scrolling(True)
        layout.pack_start(self.scroller, True, True, 0)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=CARD_SPACING)
        self.list.set_margin_start(SIDE_MARGIN)
        self.list.set_margin_end(SIDE_MARGIN)
        self.list.set_valign(Gtk.Align.START)
        self.scroller.add(self.list)

        self.empty = Gtk.Label(label="No recent items")
        self.empty.get_style_context().add_class("subtitle")
        self.empty.set_vexpand(True)
        layout.pack_start(self.empty, True, True, 0)

        self.clear = Gtk.Button(label="Clear all")
        self.clear.get_style_context().add_class("clear")
        self.clear.set_halign(Gtk.Align.CENTER)
        self.clear.set_margin_top(10)
        self.clear.set_margin_bottom(14)
        self.clear.connect("clicked", self.on_clear)
        layout.pack_start(self.clear, False, False, 0)

    def on_draw(self, widget, context):
        context.set_operator(cairo.OPERATOR_SOURCE)
        rgba(context, SCRIM_COLOR)
        context.paint()
        context.set_operator(cairo.OPERATOR_OVER)
        return False

    def present_list(self):
        for child in self.list.get_children():
            child.destroy()
        for window in windows_most_recent_first():
            self.list.pack_start(Card(window, self), False, False, 0)
        self.show_all()
        self.update_empty()
        self.scroller.get_vadjustment().set_value(0)

    def update_empty(self):
        has_cards = bool(self.list.get_children())
        self.scroller.set_visible(has_cards)
        self.clear.set_visible(has_cards)
        self.empty.set_visible(not has_cards)

    def remove_card(self, card):
        card.destroy()
        self.update_empty()

    def on_clear(self, button):
        haptic()
        for card in self.list.get_children():
            sway(f"[con_id={card.window['id']}] kill")
        self.dismiss()

    def dismiss(self):
        if self.get_visible():
            self.hide()


CSS = f"""
