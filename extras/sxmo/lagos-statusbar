def run_async(argv, done=None):
    """Run a command without blocking; done(ok, stdout) on the main loop."""
    try:
        process = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
    except GLib.Error:
        if done:
            done(False, "")
        return

    def finished(proc, result):
        try:
            ok, out, _ = proc.communicate_utf8_finish(result)
            ok = ok and proc.get_successful()
        except GLib.Error:
            ok, out = False, ""
        if done:
            done(ok, out or "")

    process.communicate_utf8_async(None, None, finished)


def time_ago(real_us):
    seconds = max(0, (GLib.get_real_time() - real_us) // 1000000)
    if seconds < 60:
        return "now"
    if seconds < 3600:
        return "%dm" % (seconds // 60)
    if seconds < 86400:
        return "%dh" % (seconds // 3600)
    return "%dd" % (seconds // 86400)


def plain(text):
    """dunst allows a little markup in bodies; the shade shows plain text."""
    try:
        return Pango.parse_markup(text, -1, "\0")[2]
    except GLib.Error:
        return text


class Tile(Gtk.Box):
    """A round quick-settings toggle with its label (and a detail line) under it."""

    def __init__(self, glyph, label, on_tap):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.glyph = glyph
        self.active = False
        self.busy = False
        self.on_tap = on_tap
        self.pressed = False
        self.button = Gtk.DrawingArea()
        self.button.set_size_request(TILE_SIZE, TILE_SIZE)
        self.button.set_halign(Gtk.Align.CENTER)
        self.button.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.button.connect("draw", self.on_draw)
        self.button.connect("button-press-event", self.on_press)
        self.button.connect("button-release-event", self.on_release)
        self.pack_start(self.button, False, False, 0)
        name = Gtk.Label(label=label)
        name.get_style_context().add_class("tile-label")
        self.pack_start(name, False, False, 0)
        self.detail = Gtk.Label(label="")
        self.detail.set_ellipsize(Pango.EllipsizeMode.END)
        self.detail.set_max_width_chars(10)
        self.detail.get_style_context().add_class("tile-detail")
        self.pack_start(self.detail, False, False, 0)

    def set_state(self, active, detail="", glyph=None):
        self.active, self.busy = active, False
        if glyph:
            self.glyph = glyph
        self.detail.set_text(detail)
        self.button.queue_draw()

    def on_press(self, widget, event):
        self.pressed = True
        widget.queue_draw()
        return True

    def on_release(self, widget, event):
        self.pressed = False
        widget.queue_draw()
        allocation = widget.get_allocation()
        if 0 <= event.x <= allocation.width and 0 <= event.y <= allocation.height and not self.busy:
            subprocess_haptic()
            self.busy = True
            self.on_tap()
        return True

    def on_draw(self, widget, context):
        size = TILE_SIZE
        context.arc(size / 2, size / 2, size / 2, 0, 2 * math.pi)
        color = ACCENT_COLOR if self.active else SURFACE_COLOR
        if self.pressed:
            color = tuple(min(1.0, c * 1.2) for c in color[:3]) + (1.0,)
        context.set_source_rgba(*color)
        context.fill()
        layout = PangoCairo.create_layout(context)
        layout.set_font_description(Pango.FontDescription.from_string("DejaVuSansM Nerd Font Propo 18"))
        layout.set_text(self.glyph, -1)
        w, h = layout.get_pixel_size()
        context.move_to((size - w) / 2, (size - h) / 2)
        glyph_color = ISLAND_COLOR if self.active else TEXT_COLOR
        if self.busy:
            glyph_color = SUBTLE_COLOR
        context.set_source_rgba(*glyph_color)
        PangoCairo.show_layout(context, layout)
        return True


def subprocess_haptic():
    run_async(["lagos-vibrate", "12"])


class Card(Gtk.EventBox):
    """One notification: app glyph, summary, body, age, and a dismiss button."""

    def __init__(self, shade, notification_id, entry):
        super().__init__()
        self.shade = shade
        self.notification_id = notification_id
        self.entry = entry
        self.pressed = False
        self.set_visible_window(False)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.connect("button-release-event", self.on_release)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.set_margin_start(CARD_PADDING + 2)
        row.set_margin_end(6)
        row.set_margin_top(CARD_PADDING - 4)
        row.set_margin_bottom(CARD_PADDING - 4)
        glyph = Gtk.Label()
        glyph.set_markup('<span font="DejaVuSansM Nerd Font Propo 16">%s</span>'
                         % GLib.markup_escape_text(glyph_for(entry["key"])))
        glyph.set_valign(Gtk.Align.START)
        glyph.set_margin_top(2)
        row.pack_start(glyph, False, False, 0)

        texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        summary = Gtk.Label(label=plain(entry["summary"]) or entry["key"], xalign=0)
        summary.set_ellipsize(Pango.EllipsizeMode.END)
        summary.get_style_context().add_class("summary")
        top.pack_start(summary, True, True, 0)
        age = Gtk.Label(label=time_ago(entry["time"]))
        age.get_style_context().add_class("time")
        top.pack_end(age, False, False, 0)
        texts.pack_start(top, False, False, 0)
        body_text = plain(entry["body"]).strip()
        if body_text:
            body = Gtk.Label(label=body_text, xalign=0)
            body.set_line_wrap(True)
            body.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            body.set_lines(2)
            body.set_ellipsize(Pango.EllipsizeMode.END)
            body.get_style_context().add_class("body")
            texts.pack_start(body, False, False, 0)
        else:  # the summary is all there is: let it take two lines
            summary.set_line_wrap(True)
            summary.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
            summary.set_lines(2)
        row.pack_start(texts, True, True, 0)

        dismiss = Gtk.Button(label=GLYPH_CLOSE)
        dismiss.get_style_context().add_class("dismiss")
        dismiss.set_size_request(40, 40)
        dismiss.set_valign(Gtk.Align.CENTER)
        dismiss.connect("clicked", lambda *_: self.shade.dismiss(self))
        row.pack_end(dismiss, False, False, 0)
        self.add(row)

    def on_draw(self, widget, context):
        allocation = self.get_allocation()
        radius = min(CARD_RADIUS, allocation.height / 2)
        rounded_rectangle(context, 0, 0, allocation.width, allocation.height, radius)
        context.set_source_rgba(*(SURFACE_COLOR if not self.pressed else PILL_TRACK))
        context.fill()
        return False

    def on_press(self, widget, event):
        self.pressed = True
        self.queue_draw()
        return True

    def on_release(self, widget, event):
        self.pressed = False
        self.queue_draw()
        allocation = self.get_allocation()
        if 0 <= event.x <= allocation.width and 0 <= event.y <= allocation.height:
            self.shade.open_notification(self)
        return True


class Shade(Gtk.Window):
    def __init__(self, notifications):
        super().__init__()
        self.notifications = notifications
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                     GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        # exclusive zone 0: between the status bar and the nav bar, both stay usable
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(self, "lagos-shade")
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.get_style_context().add_class("shade")
        self.connect("draw", self.on_draw)

        # taps on empty space close it, so does a swipe up anywhere
        outer = Gtk.EventBox()
        outer.set_visible_window(False)
        outer.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK)
        outer.connect("button-press-event", self.on_outer_press)
        outer.connect("button-release-event", self.on_outer_release)
        self.add(outer)
        self.press_y = None

        layout = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        layout.set_margin_start(SHADE_MARGIN)
        layout.set_margin_end(SHADE_MARGIN)
        layout.set_margin_top(10)
        outer.add(layout)

        tiles = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        tiles.set_homogeneous(True)
        self.mobile = Tile(GLYPH_MOBILE, "Mobile data", self.toggle_mobile)
        self.wifi = Tile(GLYPH_WIFI, "Wi-Fi", self.toggle_wifi)
        self.bluetooth = Tile(GLYPH_BLUETOOTH, "Bluetooth", self.toggle_bluetooth)
        self.flashlight = Tile(GLYPH_FLASHLIGHT, "Flashlight", self.toggle_flashlight)
        for tile in (self.mobile, self.wifi, self.bluetooth, self.flashlight):
            tiles.pack_start(tile, True, True, 0)
        layout.pack_start(tiles, False, False, 0)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        header.set_margin_top(14)
        header.set_margin_bottom(8)
        title = Gtk.Label(label="Notifications", xalign=0)
        title.get_style_context().add_class("header")
        title.set_margin_start(6)
        header.pack_start(title, True, True, 0)
        self.clear_button = Gtk.Button(label="Clear all")
        self.clear_button.get_style_context().add_class("clear")
        self.clear_button.set_margin_end(6)
        self.clear_button.connect("clicked", self.on_clear)
        header.pack_end(self.clear_button, False, False, 0)
        layout.pack_start(header, False, False, 0)

        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scroller.set_kinetic_scrolling(True)
        self.scroller.set_propagate_natural_height(True)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.list.set_valign(Gtk.Align.START)
        self.list.set_margin_bottom(10)
        self.scroller.add(self.list)
        layout.pack_start(self.scroller, False, False, 0)
        self.empty = Gtk.Label(label="No notifications")
        self.empty.get_style_context().add_class("empty")
        self.empty.set_margin_top(24)
        layout.pack_start(self.empty, False, False, 0)

        self.refresh_id = None
        self.tiles_box, self.header_box = tiles, header
        self.connect("size-allocate", self.on_size)

    def on_size(self, widget, allocation):
        """The list takes the height left under the tiles and the header, and scrolls past it."""
        used = 10 + self.tiles_box.get_allocated_height() + self.header_box.get_allocated_height() + 22 + 10
        height = max(100, allocation.height - used)
        if self.scroller.get_max_content_height() != height:
            self.scroller.set_max_content_height(height)

    # --- open/close ---------------------------------------------------------

    def open(self):
        self.rebuild()
        self.refresh_toggles()
        self.show_all()
        self.update_empty()
        self.scroller.get_vadjustment().set_value(0)
        if self.refresh_id is None:  # the toggles' state while it's open (e.g. mobile data connecting)
            self.refresh_id = GLib.timeout_add_seconds(3, self.periodic_refresh)

    def close(self):
        if self.get_visible():
            self.hide()
        if self.refresh_id is not None:
            GLib.source_remove(self.refresh_id)
            self.refresh_id = None

    def toggle(self):
        if self.get_visible():
            self.close()
        else:
            self.open()

    def periodic_refresh(self):
        self.refresh_toggles()
        return True

    def notifications_changed(self):
        if self.get_visible():
            self.rebuild()
            self.list.show_all()
            self.update_empty()

    def on_draw(self, widget, context):
        context.set_operator(cairo.OPERATOR_SOURCE)
        context.set_source_rgba(*SCRIM_COLOR)
        context.paint()
        context.set_operator(cairo.OPERATOR_OVER)
        return False

    def on_outer_press(self, widget, event):
        self.press_y = event.y
        return True

    def on_outer_release(self, widget, event):
        if self.press_y is not None and (event.y < self.press_y - 40 or abs(event.y - self.press_y) < 10):
            self.close()
        self.press_y = None
        return True

    # --- notifications --------------------------------------------------------

    def rebuild(self):
        for child in self.list.get_children():
            child.destroy()
        for notification_id, entry in self.notifications.newest_first():
            self.list.pack_start(Card(self, notification_id, entry), False, False, 0)

    def update_empty(self):
        has = bool(self.list.get_children())
        self.scroller.set_visible(has)
        self.clear_button.set_visible(has)
        self.empty.set_visible(not has)

    def dismiss(self, card):
        subprocess_haptic()
        self.notifications.dismiss(card.notification_id)

    def open_notification(self, card):
        """dunst can only fire an app's action while the popup is on screen (a
        popped history entry has lost its target), so focus the app instead."""
        subprocess_haptic()
        key = card.entry["key"]
        if key and key != "android-translation-layer":
            run_async(["swaymsg", '[app_id="%s"] focus' % key.replace('"', "")])
        self.notifications.dismiss(card.notification_id)
        self.close()

    def on_clear(self, button):
        subprocess_haptic()
        self.notifications.dismiss_all()

    # --- toggles --------------------------------------------------------------

    def refresh_toggles(self):
        run_async(["nmcli", "-t", "-f", "TYPE,NAME", "connection", "show", "--active"], self.got_connections)
        run_async(["nmcli", "-t", "-g", "WIFI", "radio"], self.got_wifi_radio)
        run_async(["bluetoothctl", "show"], self.got_bluetooth)
        try:
            with open(FLASHLIGHT) as handle:
                lines = handle.read().splitlines()
            on = any(line.split()[-1:] == ["1"] for line in lines[1:] if line.strip())
            self.flashlight.set_state(on, "On" if on else "")
        except OSError:
            self.flashlight.set_state(False, "Unavailable")

    def got_connections(self, ok, out):
        self.active = {}
        for line in out.splitlines():
            kind, _, name = line.partition(":")
            self.active.setdefault(kind, name)
        gsm = self.active.get("gsm")
        if not self.mobile.busy:
            self.mobile.set_state(bool(gsm), gsm or "Off")
        self.wifi_name = self.active.get("802-11-wireless", "")
        self.update_wifi()

    def got_wifi_radio(self, ok, out):
        self.wifi_radio = out.strip() == "enabled"
        self.update_wifi()

    def update_wifi(self):
        radio = getattr(self, "wifi_radio", None)
        if radio is None or self.wifi.busy:
            return
        name = getattr(self, "wifi_name", "")
        detail = name if radio and name else "On" if radio else "Off"
        self.wifi.set_state(radio, detail, GLYPH_WIFI if radio else GLYPH_WIFI_OFF)

    def got_bluetooth(self, ok, out):
        powered = "Powered: yes" in out
        self.bluetooth.set_state(powered, "On" if powered else "Off" if ok else "Unavailable")

    def toggle_mobile(self):
        def listed(ok, out):
            names = [line.partition(":")[2] for line in out.splitlines() if line.startswith("gsm:")]
            if not names:
                self.mobile.set_state(False, "No APN")
                return
            action = "down" if self.mobile.active else "up"
            self.mobile.detail.set_text("Connecting…" if action == "up" else "Disconnecting…")
            run_async(["nmcli", "connection", action, "id", names[0]], self.toggled)
        run_async(["nmcli", "-t", "-f", "TYPE,NAME", "connection", "show"], listed)

    def toggle_wifi(self):
        run_async(["nmcli", "radio", "wifi", "off" if self.wifi.active else "on"], self.toggled)

    def toggle_bluetooth(self):
        run_async(["bluetoothctl", "power", "off" if self.bluetooth.active else "on"], self.toggled)

    def toggle_flashlight(self):
        try:
            with open(FLASHLIGHT, "w") as handle:
                handle.write("0 0 0 %d" % (0 if self.flashlight.active else 1))
        except OSError:
            pass
        self.toggled(True, "")

    def toggled(self, ok, out):
        for tile in (self.mobile, self.wifi, self.bluetooth, self.flashlight):
            tile.busy = False
        self.refresh_toggles()


class StatusBar(Gtk.Window):
    def __init__(self):
        super().__init__()
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.TOP)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.auto_exclusive_zone_enable(self)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        GtkLayerShell.set_namespace(self, "lagos-statusbar")
        self.set_size_request(-1, BAR_HEIGHT)
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)
        self.add_events(Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-release-event", self.on_release)
        self.left_island = None  # (x, width) of the left island, for taps and the input region

        self.battery_path = find_battery()
        self.items = []
        self.level, self.charging = None, False
        self.notifications = NotificationTracker(self.notifications_changed)
        self.shade = Shade(self.notifications)
        self.reload()

        self.monitor = Gio.File.new_for_path(STORE).monitor_file(Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.set_rate_limit(100)
        self.monitor.connect("changed", lambda *_: self.reload())

    def reload(self):
        items = read_store()
        battery = read_battery(self.battery_path)
        if items != self.items or battery != (self.level, self.charging):
            self.items = items
            self.level, self.charging = battery
            self.queue_draw()

    def notifications_changed(self):
        self.queue_draw()
        if hasattr(self, "shade"):
            self.shade.notifications_changed()

    def on_release(self, widget, event):
        if self.left_island and self.left_island[0] <= event.x <= self.left_island[0] + self.left_island[1]:
            self.shade.toggle()
        return True

    def set_input_island(self, island):
        """Only the left island takes touches (it opens the shade); the rest of
        the bar lets them through."""
        if island == self.left_island or not self.get_window():
            return
        self.left_island = island
        region = cairo.Region()
        if island:
            region = cairo.Region(cairo.RectangleInt(int(island[0]), 0, int(island[1]), BAR_HEIGHT))
        self.input_shape_combine_region(region)

    # --- drawing ------------------------------------------------------------

    def layout(self, context, text, font):
        layout = PangoCairo.create_layout(context)
        layout.set_font_description(Pango.FontDescription.from_string(font))
        layout.set_text(text, -1)
        return layout

    def show(self, context, layout, x, top, color):
        w, h = layout.get_pixel_size()
        context.set_source_rgba(*color)
        context.move_to(x, top + (ISLAND_HEIGHT - h) / 2)
        PangoCairo.show_layout(context, layout)
        return w

    def on_draw(self, widget, context):
        context.set_operator(cairo.OPERATOR_SOURCE)
        context.set_source_rgba(0, 0, 0, 0)
        context.paint()
        context.set_operator(cairo.OPERATOR_OVER)

        width = self.get_allocated_width()
        top = (BAR_HEIGHT - ISLAND_HEIGHT) / 2
        inset = corner_inset(top, ISLAND_HEIGHT)
        camera_left = width * CAMERA_CENTER - CAMERA_GAP / 2
        camera_right = width * CAMERA_CENTER + CAMERA_GAP / 2

        # left island: screen edge to camera; clock, then notification icons
        left_width = camera_left - inset
        self.island(context, inset, top, left_width)
        x = inset + ISLAND_PADDING
        clock = next((item["content"] for item in self.items if item["name"] == "time"), "")
        if clock:
            x += self.show(context, self.layout(context, clock, TEXT_FONT), x, top, TEXT_COLOR) + ISLAND_SPACING + 2
        apps = self.notifications.apps()
        for key in apps[:MAX_NOTIFICATION_ICONS]:
            x += self.show(context, self.layout(context, glyph_for(key), ICON_FONT), x, top, TEXT_COLOR) + ISLAND_SPACING
        if len(apps) > MAX_NOTIFICATION_ICONS:
            self.show(context, self.layout(context, "+%d" % (len(apps) - MAX_NOTIFICATION_ICONS), COUNT_FONT),
                      x, top, SUBTLE_COLOR)
        self.set_input_island((inset, left_width))

        # right island: camera to screen edge; status icons, battery pill at the end
        right_end = width - inset
        self.island(context, camera_right, top, right_end - camera_right)
        x = right_end - ISLAND_PADDING
        if self.level is not None:
            x -= PILL_WIDTH
            self.battery_pill(context, x, top + (ISLAND_HEIGHT - PILL_HEIGHT) / 2)
            x -= ISLAND_SPACING
        for item in reversed(self.items):
            if item["name"].startswith(LEFT_OUT) or not item["content"]:
                continue
            layout = self.layout(context, item["content"], ICON_FONT)
            w, _ = layout.get_pixel_size()
            if x - w < camera_right + ISLAND_PADDING:
                break
            x -= w
            self.show(context, layout, x, top, color_of(item["color"]))
            x -= ISLAND_SPACING
        return True

    def island(self, context, x, y, width):
        if width <= 0:
            return
        rounded_rectangle(context, x, y, width, ISLAND_HEIGHT, ISLAND_HEIGHT / 2)
        context.set_source_rgba(*ISLAND_COLOR)
        context.fill()

    def battery_pill(self, context, x, y):
        radius = PILL_HEIGHT / 2
        rounded_rectangle(context, x, y, PILL_WIDTH, PILL_HEIGHT, radius)
        context.set_source_rgba(*PILL_TRACK)
        context.fill()

        fill_width = PILL_WIDTH * self.level / 100
        fill = PILL_CHARGING if self.charging else PILL_LOW if self.level <= LOW_BATTERY else PILL_FILL
        context.save()
        rounded_rectangle(context, x, y, PILL_WIDTH, PILL_HEIGHT, radius)
        context.clip()
        context.rectangle(x, y, fill_width, PILL_HEIGHT)
        context.set_source_rgba(*fill)
        context.fill()
        context.restore()

        text = ("\U000f140b" if self.charging else "") + str(self.level)
        layout = self.layout(context, text, PILL_FONT)
        w, h = layout.get_pixel_size()
        tx, ty = x + (PILL_WIDTH - w) / 2, y + (PILL_HEIGHT - h) / 2
        # dark text over the filled part, light text over the track
        for clip_x, clip_w, color in ((x, fill_width, PILL_TEXT_ON_FILL),
                                      (x + fill_width, PILL_WIDTH - fill_width, TEXT_COLOR)):
            if clip_w <= 0:
                continue
            context.save()
            context.rectangle(clip_x, y, clip_w, PILL_HEIGHT)
            context.clip()
            context.set_source_rgba(*color)
            context.move_to(tx, ty)
            PangoCairo.show_layout(context, layout)
            context.restore()


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(SHADE_CSS.encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    bar = StatusBar()
    bar.show_all()
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, lambda: bar.shade.toggle() or True)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, lambda: bar.shade.close() or True)
    try:
        with open(PIDFILE, "w") as handle:
            handle.write("%d\n" % os.getpid())
    except OSError:
        pass
    Gtk.main()


if __name__ == "__main__":
    main()
