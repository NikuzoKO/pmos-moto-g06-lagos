#!/bin/sh
# lagos-shade [toggle|open|close]: the notification shade in lagos-statusbar
# (SIGUSR1 toggles it, SIGUSR2 closes it). open = toggle unless already open,
# which the bar knows and this script doesn't, so open behaves as toggle.
pid=$(cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lagos-statusbar.pid" 2>/dev/null) || exit 1
case "${1:-toggle}" in
	close) kill -USR2 "$pid" ;;
	*) kill -USR1 "$pid" ;;
esac
