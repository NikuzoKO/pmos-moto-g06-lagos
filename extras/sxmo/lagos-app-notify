#!/bin/sh
# dunst script for notifications from Android apps (Android Translation Layer,
# see dunstrc.d/60-android-apps.conf): sound + buzz like sxmo_hook_sms.sh,
# honouring the notification channel mode (lagos-sound) and sxmo's .busy (silent until), .noring and .novibrate flags. Runs
# again when an app updates a notification (WhatsApp does so for every new
# message in a chat).
# Low urgency = an ongoing notification or a repeat of an onlyAlertOnce one
# (ATL sets it): Android stays quiet for those
[ "$DUNST_URGENCY" = LOW ] && exit 0
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sxmo"
if [ -f "$cfg/.busy" ]; then
	end="$(cat "$cfg/.busy")"
	if [ -z "$end" ] || [ "$(date +%s)" -lt "$end" ]; then
		exit 0
	fi
fi
# Channel state from the volume panel (and vibrate-only at night)
mode="$("$HOME/.local/bin/lagos-sound" mode notify 2>/dev/null || echo sound)"
if [ "$mode" = sound ] && [ ! -f "$cfg/.noring" ]; then
	sound="${SXMO_TEXTSOUND:-/usr/share/sxmo/notify.ogg}"
	mpv --no-resume-playback --quiet --no-video --audio-device=pipewire/lagos-notify "$sound" >/dev/null 2>&1 &
fi
if [ "$mode" != mute ] && [ ! -f "$cfg/.novibrate" ]; then
	"$HOME/.local/bin/lagos-vibrate" 200 200 &
fi
wait
