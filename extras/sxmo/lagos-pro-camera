        for key in ("exp", "shutter", "iso", "focus", "ev", "wb"):
            button = Gtk.Button()
            button.get_style_context().add_class("val")
            button.connect("clicked", self.on_val, key)
            row.pack_start(button, True, True, 0)
            self.val_buttons[key] = button
        self.pro_box.pack_start(row, False, False, 0)

        self.strip = Gtk.Box(spacing=6)
        self.strip.set_size_request(-1, 44)
        self.scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL)
        self.scale.set_draw_value(False)
        self.scale.set_hexpand(True)
        self.scale.connect("value-changed", self.on_scale)
        self.strip_label = Gtk.Label()
        self.strip_label.set_width_chars(8)
        self.strip.pack_start(self.scale, True, True, 4)
        self.strip.pack_start(self.strip_label, False, False, 4)
        self.af_button = Gtk.Button(label="AF")
        self.af_button.get_style_context().add_class("chip")
        self.af_button.connect("clicked", self.on_af_toggle)
        self.strip.pack_start(self.af_button, False, False, 0)
        self.pro_box.pack_start(self.strip, False, False, 0)

        self.wb_box = Gtk.FlowBox()
        self.wb_box.set_max_children_per_line(4)
        self.wb_box.set_min_children_per_line(4)
        self.wb_box.set_selection_mode(Gtk.SelectionMode.NONE)
        self.wb_buttons = {}
        for name, ident in WB_PRESETS + [("Kelvin", 0)]:
            button = Gtk.Button(label=name)
            button.get_style_context().add_class("chip")
            button.connect("clicked", self.on_wb, ident)
            self.wb_box.add(button)
            self.wb_buttons[ident] = button
        self.pro_box.pack_start(self.wb_box, False, False, 0)
        outer.pack_start(self.pro_box, False, False, 0)

        # shutter modes + shutter row
        modes = Gtk.Box(spacing=4, homogeneous=True)
        modes.set_margin_start(6)
        modes.set_margin_end(6)
        modes.set_margin_top(4)
        self.mode_buttons = []
        for index, name in enumerate(MODES):
            button = Gtk.Button(label=name)
            button.get_style_context().add_class("chip")
            button.connect("clicked", self.on_mode, index)
            modes.pack_start(button, True, True, 0)
            self.mode_buttons.append(button)
        outer.pack_start(modes, False, False, 0)

        bottom = Gtk.Box(spacing=0)
        bottom.set_margin_top(6)
        bottom.set_margin_bottom(8)
        self.thumb = Gtk.Button()
        self.thumb.get_style_context().add_class("side")
        self.thumb.connect("clicked", self.on_thumb)
        self.thumb_image = Gtk.Image()
        self.thumb.add(self.thumb_image)
        self.shutter_button = Gtk.Button()
        self.shutter_button.get_style_context().add_class("shutter")
        self.shutter_button.connect("clicked", self.on_shutter)
        self.pro_button = Gtk.Button(label="PRO")
        self.pro_button.get_style_context().add_class("side")
        self.pro_button.connect("clicked", self.on_pro)
        for widget in (self.thumb, self.shutter_button, self.pro_button):
            widget.set_halign(Gtk.Align.CENTER)
            widget.set_valign(Gtk.Align.CENTER)
            bottom.pack_start(widget, True, False, 0)
        outer.pack_start(bottom, False, False, 0)

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.get_style_context().add_class("cam")
        self.connect("destroy", self.on_destroy)
        self.set_default_size(360, 740)
        self.show_all()
        self.refresh_ui()
        self.load_thumb()
        GLib.timeout_add(33, self.on_tick)
        GLib.timeout_add(100, self.on_events)
        self.start_camera()

    # ------------------------------------------------------------------ camera
    def rotation(self):
        override = os.environ.get("LAGOS_CAM_ROT", "")
        if override:
            parts = override.split(",")
            return int(parts[self.s.camera]) if self.s.camera < len(parts) else 0
        return 90 if self.s.camera == 0 else 270

    def mirror(self):
        override = os.environ.get("LAGOS_CAM_ROT", "")
        if override and len(override.split(",")) > 2:
            return self.s.camera == 1 and override.split(",")[2] == "mirror"
        return self.s.camera == 1

    def jpeg_orientation(self):
        # EXIF orientation that displays the (landscape) sensor frame upright
        return {90: 6, 180: 3, 270: 8, 0: 1}[self.rotation()]

    def preview_gain(self):
        s = self.s
        if s.manual_exp and s.shutter > 0.1:
            return min(s.shutter / 0.1, 16.0)
        return 1.0

    def start_camera(self):
        if self.starting:
            return
        self.starting = True
        self.ready = False
        self.cam.ev_pos = 0
        self.view.banner = "Starting camera…"
        self.view.queue_draw()
        proc = Gio.Subprocess.new([f"{BIN}/lagos-camera", "start", str(self.s.camera),
                                   str(PREVIEW[0]), str(PREVIEW[1])],
                                  Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        proc.wait_async(None, self.on_camera_started)

    def on_camera_started(self, proc, result):
        try:
            proc.wait_finish(result)
        except GLib.Error:
            pass
        self.started_at = time.monotonic()
        GLib.timeout_add(250, self.wait_ready)

    def wait_ready(self):
        if not self.starting:
            return False
        if time.monotonic() - self.started_at > 60:
            self.starting = False
            self.view.banner = "Camera failed to start"
            self.view.queue_draw()
            return False
        return True

    def camera_ready(self):
        self.starting = False
        self.ready = True
        self.cam.open_frames()
        self.view.banner = ""
        self.apply_settings()

    def apply_settings(self):
        if not self.ready:
            return
        s = self.s
        parts = []
        if s.manual_exp:
            parts += ["ae=manual", f"shutter={min(s.shutter, 30):.6f}", f"iso={s.iso}"]
        else:
            parts += ["ae=auto", f"ev={s.ev}"]
        if s.camera == 0:
            parts.append("focus=cont" if s.af else f"focus={s.focus:.3f}")
        if s.pro and s.wb == 0:
            r, b = kelvin_gains(s.kelvin)
            parts.append(f"wb={r:.3f},{b:.3f}")
        else:
            parts.append(f"awb={s.wb if s.pro else 1}")
        self.cam.send("set " + " ".join(parts))

    def on_tick(self):
        if self.ready and not self.busy:
            frame = self.cam.grab()
            if frame is not None:
                self.view.set_frame(frame[1], frame[0])
        return True

    def on_events(self):
        for event in self.cam.events():
            if not event:
                continue
            if event[0] == "ready" and self.starting:
                self.camera_ready()
            elif self.pending_shot and (event[0] == "err" or event[:2] == ["ok", "shot"]):
                self.shot_result = event
        return True

    def tap_focus(self):
        if self.s.camera == 0 and self.ready and not self.busy:
            self.cam.send("af")
            self.s.af = True
            if self.s.pro:
                self.refresh_ui()

    # ----------------------------------------------------------------- capture
    def shot_command(self, path, extra=""):
        s = self.s
        parts = ["q=95"]
        if s.manual_exp:
            parts += ["ae=manual", f"shutter={min(s.shutter, 30):.6f}", f"iso={s.iso}"]
        else:
            parts += ["ae=auto", f"ev={s.ev}"]
        if s.camera == 0:
            parts.append("focus=auto" if s.af else f"focus={s.focus:.3f}")
        if s.pro and s.wb == 0:
            r, b = kelvin_gains(s.kelvin)
            parts.append(f"wb={r:.3f},{b:.3f}")
        else:
            parts.append(f"awb={s.wb if s.pro else 1}")
        return f"shot {CHROOT_RUN}/{path} {' '.join(parts)} {extra}".strip()

    def take(self, name, extra="", timeout=15):
        """Generator step: one shot; the caller does `res = yield from self.take(...)`."""
        self.cam.send(self.shot_command(name, extra))
        self.pending_shot = name
        start = time.monotonic()
        while True:
            if self.shot_result is not None:
                result, self.shot_result = self.shot_result, None
                self.pending_shot = None
                break
            if time.monotonic() - start > timeout:
                result = ["err", "timeout"]
                self.pending_shot = None
                break
            yield ("wait", 0.05)
        if result[0] == "ok":
            return self.finish_photo(name)
        return None

    def finish_photo(self, name):
        stamp = time.strftime("%Y%m%d_%H%M%S")
        base = f"IMG_{stamp}"
        dest = os.path.join(PHOTO_DIR, f"{base}.jpg")
        counter = 1
        while os.path.exists(dest):
            dest = os.path.join(PHOTO_DIR, f"{base}_{counter}.jpg")
            counter += 1
        try:
            shutil.move(os.path.join(RUN, name), dest)
        except OSError as error:
            self.view.banner = f"Save failed: {error}"
            return None
        subprocess.run(["exiftool", "-n", f"-Orientation={self.jpeg_orientation()}",
                        "-overwrite_original", dest], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        self.last_photo = dest
        self.load_thumb()
        return dest

    def set_busy(self, busy, label=""):
        self.busy = busy
        ctx = self.shutter_button.get_style_context()
        (ctx.add_class if busy else ctx.remove_class)("busy")
        self.view.banner = label
        self.view.queue_draw()

    def on_shutter(self, _button):
        if not self.ready:
            return
        if self.task is not None and self.busy:
            self.cancel()
            return
        vibrate()
        mode = MODES[self.s.mode]
        generator = {"Photo": self.job_photo, "Timer": self.job_timer, "Burst": self.job_burst,
                     "Long": self.job_long, "HDR": self.job_hdr}[mode]()
        self.set_busy(True)
        self.task = Task(self, generator)

    def cancel(self):
        if self.task:
            self.task.cancelled = True
        self.view.countdown = ""
        self.set_busy(False)
        self.cam.send("reset")
        GLib.timeout_add(200, lambda: self.apply_settings() and False)

    def done(self, photos):
        self.view.countdown = ""
        self.set_busy(False, "")
        if photos:
            vibrate(25)
            if self.s.enhance:
                for photo in photos:
                    subprocess.Popen([f"{BIN}/lagos-photo-enhance", photo], stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL)
            self.view.banner = f"Saved {os.path.basename(photos[-1])}"
            GLib.timeout_add(2500, self.clear_banner)
        else:
            self.view.banner = "Capture failed"
            GLib.timeout_add(2500, self.clear_banner)

    def clear_banner(self):
        if not self.busy and not self.starting:
            self.view.banner = ""
            self.view.queue_draw()
        return False

    def exposing_label(self):
        s = self.s
        return f"Exposing {fmt_shutter(s.shutter)}…" if s.manual_exp and s.shutter >= 1 else "Capturing…"

    def job_photo(self):
        self.view.banner = self.exposing_label()
        self.view.queue_draw()
        timeout = 20 + (self.s.shutter * 3 if self.s.manual_exp else 0)
        photo = yield from self.take(f"p{int(time.time() * 1000)}.jpg", timeout=timeout)
        self.done([photo] if photo else [])

    def job_timer(self):
        for remaining in range(TIMERS[self.s.timer], 0, -1):
            self.view.countdown = str(remaining)
            self.view.queue_draw()
            yield ("wait", 1.0)
        self.view.countdown = ""
        yield from self.job_photo()

    def job_burst(self):
        photos = []
        for index in range(BURST_COUNT):
            self.view.banner = f"Burst {index + 1}/{BURST_COUNT}"
            self.view.queue_draw()
            photo = yield from self.take(f"b{int(time.time() * 1000)}.jpg", timeout=20)
            if photo:
                photos.append(photo)
        self.done(photos)

    def job_long(self):
        s = self.s
        if not s.manual_exp:
            s.manual_exp = True
        seconds = max(s.shutter, 1)
        if s.shutter < 1:
            s.shutter_idx = SHUTTERS.index(4)
            seconds = 4
        start = time.monotonic()
        name = f"l{int(time.time() * 1000)}.jpg"
        self.cam.send(self.shot_command(name))
        self.pending_shot = True
        while self.shot_result is None:
            left = max(0, seconds - (time.monotonic() - start))
            self.view.countdown = f"{left:.0f}" if left > 0 else "…"
            self.view.queue_draw()
            if time.monotonic() - start > seconds * 3 + 25:
                self.shot_result = ["err", "timeout"]
                break
            yield ("wait", 0.2)
        result, self.shot_result = self.shot_result, None
        self.pending_shot = None
        self.view.countdown = ""
        photo = None
        if result[0] == "ok" and len(result) > 2:
            photo = self.finish_photo(os.path.basename(result[2]))
        self.done([photo] if photo else [])

    def job_hdr(self):
        s = self.s
        shots = []
        if s.manual_exp:
            base = s.shutter_idx
            variants = [("", max(base - 2, 0)), ("", base), ("", min(base + 2, len(SHUTTERS) - 1))]
            extras = [f"shutter={SHUTTERS[i]:.6f}" for _n, i in variants]
        else:
            extras = ["ev=-4", "ev=0", "ev=4"]
        for index, extra in enumerate(extras):
            self.view.banner = f"HDR {index + 1}/3"
            self.view.queue_draw()
            photo = yield from self.take(f"h{int(time.time() * 1000)}.jpg", extra=extra, timeout=30)
            if photo:
                shots.append(photo)
        if len(shots) == 3:
            self.view.banner = "Merging HDR…"
            self.view.queue_draw()
            out = shots[1].replace(".jpg", "_HDR.jpg")
            proc = Gio.Subprocess.new([f"{BIN}/lagos-photo-enhance", "--hdr", out] + shots,
                                      Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
            finished = {}
            proc.wait_async(None, lambda p, r: finished.setdefault("ok", p.wait_check_finish(r)))
            while "ok" not in finished:
                yield ("wait", 0.3)
            if os.path.exists(out):
                self.last_photo = out
                self.load_thumb()
                self.done([])
                self.view.banner = f"Saved {os.path.basename(out)}"
                return
        self.done(shots)

    # ---------------------------------------------------------------------- ui
    def load_thumb(self):
        if not self.last_photo:
            photos = sorted(f for f in os.listdir(PHOTO_DIR) if f.lower().endswith(".jpg"))
            if photos:
                self.last_photo = os.path.join(PHOTO_DIR, photos[-1])
        if self.last_photo:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(self.last_photo, 96, 96)
                pixbuf = pixbuf.apply_embedded_orientation() or pixbuf
                side = min(pixbuf.get_width(), pixbuf.get_height())
                pixbuf = pixbuf.new_subpixbuf((pixbuf.get_width() - side) // 2,
                                              (pixbuf.get_height() - side) // 2, side, side)
                pixbuf = pixbuf.scale_simple(44, 44, GdkPixbuf.InterpType.BILINEAR)
                self.thumb_image.set_from_pixbuf(pixbuf)
            except GLib.Error:
                pass

    def on_thumb(self, _button):
        if self.last_photo:
            subprocess.Popen(["swaymsg", "exec", f"{BIN}/lagos-photo-edit '{self.last_photo}'"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def on_pro(self, _button):
        self.s.pro = not self.s.pro
        self.apply_settings()
        self.refresh_ui()

    def on_toggle(self, _button, key):
        s = self.s
        if key == "flip":
            s.camera = 1 - s.camera
            s.save()
            self.cam.send("reset")
            self.start_camera()
            self.refresh_ui()
            return
        if key == "grid":
            s.grid = (s.grid + 1) % len(GRIDS)
        else:
            setattr(s, key, not getattr(s, key))
        s.save()
        self.refresh_ui()
        self.view.queue_draw()

    def on_mode(self, _button, index):
        if self.s.mode == index and MODES[index] == "Timer":
            self.s.timer = (self.s.timer + 1) % len(TIMERS)
        self.s.mode = index
        if MODES[index] == "Long" and self.s.pro:
            self.s.manual_exp = True
            if self.s.shutter < 1:
                self.s.shutter_idx = SHUTTERS.index(4)
            self.s.iso_idx = ISOS.index(100)
            self.panel = "shutter"
            self.apply_settings()
        self.s.save()
        self.refresh_ui()

    def on_val(self, _button, key):
        s = self.s
        if key == "exp":
            s.manual_exp = not s.manual_exp
            self.panel = "shutter" if s.manual_exp else "ev"
            self.apply_settings()
        else:
            self.panel = key
        self.refresh_ui()

    def on_af_toggle(self, _button):
        self.s.af = not self.s.af
        self.apply_settings()
        self.refresh_ui()

    def on_wb(self, _button, ident):
        self.s.wb = ident
        self.apply_settings()
        self.refresh_ui()

    def on_scale(self, scale):
        if getattr(self, "updating", False):
            return
        s = self.s
        value = scale.get_value()
        if self.panel == "shutter":
            s.shutter_idx = int(round(value))
            s.manual_exp = True
        elif self.panel == "iso":
            s.iso_idx = int(round(value))
            s.manual_exp = True
        elif self.panel == "ev":
            s.ev = int(round(value))
        elif self.panel == "focus":
            s.focus = value
            s.af = False
        elif self.panel == "wb":
            s.kelvin = int(round(value / 100.0) * 100)
            s.wb = 0
        self.update_labels()
        if self.apply_pending is None:
            self.apply_pending = GLib.timeout_add(90, self.flush_apply)

    apply_pending = None

    def flush_apply(self):
        self.apply_pending = None
        self.apply_settings()
        self.s.save()
        return False

    def update_labels(self):
        s = self.s
        title = lambda name, value, dim=False: (  # noqa: E731
            f'<span size="x-small" foreground="#908caa">{name}</span>\n<span size="small"><b>{value}</b></span>')
        labels = {
            "exp": title("EXPO", "MAN" if s.manual_exp else "AUTO"),
            "shutter": title("SHUTTER", fmt_shutter(s.shutter)),
            "iso": title("ISO", s.iso),
            "focus": title("FOCUS", "AF" if s.af and s.camera == 0 else ("fixed" if s.camera else fmt_focus(s.focus))),
            "ev": title("EV", f"{s.ev / 2:+g}"),
            "wb": title("WB", "Auto" if s.wb == 1 else (f"{s.kelvin}K" if s.wb == 0 else
                                                       dict((i, n) for n, i in WB_PRESETS)[s.wb])),
        }
        for key, markup in labels.items():
            button = self.val_buttons[key]
            child = button.get_child()
            if child is None:
                child = Gtk.Label()
                child.set_justify(Gtk.Justification.CENTER)
                button.add(child)
                child.show()
            child.set_markup(markup)
        text = {"shutter": fmt_shutter(s.shutter), "iso": str(s.iso), "ev": f"{s.ev / 2:+g} EV",
                "focus": fmt_focus(s.focus), "wb": f"{s.kelvin} K"}.get(self.panel, "")
        self.strip_label.set_text(text)

    def refresh_ui(self):
        s = self.s
        for key, button in self.toggles.items():
            ctx = button.get_style_context()
            if key == "grid":
                on = s.grid != 0
                button.set_label("GRID" if s.grid == 0 else GRIDS[s.grid].upper())
            elif key == "flip":
                on = s.camera == 1
                button.set_label("SELFIE" if on else "REAR")
            else:
                on = getattr(s, key)
            (ctx.add_class if on else ctx.remove_class)("on")
        for index, button in enumerate(self.mode_buttons):
            ctx = button.get_style_context()
            (ctx.add_class if index == s.mode else ctx.remove_class)("on")
            name = MODES[index]
            button.set_label(f"Timer {TIMERS[s.timer]}s" if name == "Timer" and index == s.mode else name)
        ctx = self.pro_button.get_style_context()
        (ctx.add_class if s.pro else ctx.remove_class)("on")
        self.pro_box.set_visible(s.pro)
        self.pro_box.set_no_show_all(False)
        if s.pro:
            self.pro_box.show_all()
            self.updating = True
            panel = self.panel
            is_wb = panel == "wb"
            self.wb_box.set_visible(is_wb)
            self.scale.set_visible(panel != "wb" or True)
            self.af_button.set_visible(panel == "focus" and s.camera == 0)
            self.strip_label.set_visible(True)
            if panel == "shutter":
                self.scale.set_range(0, len(SHUTTERS) - 1)
                self.scale.set_increments(1, 1)
                self.scale.set_value(s.shutter_idx)
            elif panel == "iso":
                self.scale.set_range(0, len(ISOS) - 1)
                self.scale.set_increments(1, 1)
                self.scale.set_value(s.iso_idx)
            elif panel == "ev":
                self.scale.set_range(-4, 4)
                self.scale.set_increments(1, 1)
                self.scale.set_value(s.ev)
            elif panel == "focus":
                self.scale.set_range(0, 10)
                self.scale.set_increments(0.1, 1)
                self.scale.set_value(s.focus)
            elif panel == "wb":
                self.scale.set_range(2500, 9000)
                self.scale.set_increments(100, 500)
                self.scale.set_value(s.kelvin)
            self.updating = False
            sensitive = {"shutter": s.manual_exp, "iso": s.manual_exp, "ev": not s.manual_exp,
                         "focus": s.camera == 0}
            for key, button in self.val_buttons.items():
                ctx = button.get_style_context()
                (ctx.add_class if key == panel else ctx.remove_class)("sel")
                dim = key in sensitive and not sensitive[key]
                (ctx.add_class if dim else ctx.remove_class)("dim")
            for ident, button in self.wb_buttons.items():
                ctx = button.get_style_context()
                (ctx.add_class if ident == s.wb else ctx.remove_class)("on")
            ctx = self.af_button.get_style_context()
            (ctx.add_class if s.af else ctx.remove_class)("on")
            self.update_labels()
            if not is_wb:
                self.wb_box.hide()
        self.view.queue_draw()

    def on_destroy(self, _widget):
        self.s.save()
        try:
            subprocess.run([f"{BIN}/lagos-camera", "stop"], timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            pass
        Gtk.main_quit()


def debug_commands(app, snapshot):
    """LAGOS_CAM_DEBUG=1: drive the UI from $XDG_RUNTIME_DIR/lagos-pro-camera.cmd (one command
    per line: pro | shutter | mode N | val KEY | toggle KEY | scale V | wb ID | af | snap | quit)."""
    path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "lagos-pro-camera.cmd")
    try:
        os.unlink(path)
    except OSError:
        pass
    os.mkfifo(path, 0o600)
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)

    def run(_fd, _cond):
        for line in os.read(fd, 4096).decode().splitlines():
            word = line.split()
            if not word:
                continue
            if word[0] == "pro":
                app.on_pro(None)
            elif word[0] == "shutter":
                app.on_shutter(None)
            elif word[0] == "mode":
                app.on_mode(None, int(word[1]))
            elif word[0] == "val":
                app.on_val(None, word[1])
            elif word[0] == "toggle":
                app.on_toggle(None, word[1])
            elif word[0] == "scale":
                app.scale.set_value(float(word[1]))
            elif word[0] == "wb":
                app.on_wb(None, int(word[1]))
            elif word[0] == "af":
                app.on_af_toggle(None)
            elif word[0] == "snap":
                snapshot()
            elif word[0] == "quit":
                app.destroy()
        return True

    GLib.io_add_watch(fd, GLib.IO_IN, run)


def main():
    if "--help" in sys.argv:
        print(__doc__)
        return
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: Gtk.main_quit() or False)
    app = ProCamera()

    def snapshot():
        # debugging: SIGUSR1 renders the window (grim is black on this sway) into $XDG_RUNTIME_DIR
        alloc = app.get_allocation()
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, alloc.width, alloc.height)
        cr = cairo.Context(surface)
        app.draw(cr)
        print("min width", app.get_preferred_width(), "alloc", alloc.width, flush=True)
        out = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "lagos-pro-camera.png")
        surface.write_to_png(out)
        return True

    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, snapshot)
    if os.environ.get("LAGOS_CAM_DEBUG"):
        debug_commands(app, snapshot)
    Gtk.main()


if __name__ == "__main__":
    main()
