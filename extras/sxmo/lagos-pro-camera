EVENT_SIZE = struct.calcsize("<qqHHi")


def vibrate(ms=12):
    try:
        subprocess.Popen([f"{BIN}/lagos-vibrate", str(ms)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except OSError:
        pass


def fmt_shutter(seconds):
    if seconds >= 1:
        return f'{seconds:g}"'
    return f"1/{round(1 / seconds)}"


def fmt_focus(diopters):
    if diopters < 0.1:
        return "∞"
    return f"{100 / diopters:.0f} cm" if diopters >= 1 else f"{1 / diopters:.1f} m"


def kelvin_gains(kelvin):
    # relative to a ~5500 K daylight neutral; the ISP's gains are absolute, so
    # BASE_* is the daylight pair (tuned with a grey card, see notes)
    base_r, base_b = 2.0, 1.7
    ratio = kelvin / 5500.0
    return base_r * ratio ** 0.75, base_b * (1 / ratio) ** 0.75


class Settings:
    def __init__(self):
        self.camera = 0              # 0 rear (CAM id 0), 1 front
        self.pro = False
        self.manual_exp = False
        self.shutter_idx = SHUTTERS.index(1 / 60)
        self.iso_idx = ISOS.index(400)
        self.ev = 0                  # half stops
        self.af = True
        self.focus = 0.0             # diopters
        self.wb = 1                  # preset id, or 0 = kelvin
        self.kelvin = 5500
        self.grid = 1
        self.hist = True
        self.zebra = False
        self.peak = False
        self.level = True
        self.enhance = False
        self.mode = 0
        self.timer = 0               # index into TIMERS

    def load(self):
        try:
            with open(CONFIG) as handle:
                data = json.load(handle)
            for key, value in data.items():
                if hasattr(self, key):
                    setattr(self, key, value)
        except (OSError, ValueError):
            pass

    def save(self):
        try:
            os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
            with open(CONFIG, "w") as handle:
                json.dump(self.__dict__, handle)
        except OSError:
            pass

    @property
    def shutter(self):
        return SHUTTERS[self.shutter_idx]

    @property
    def iso(self):
        return ISOS[self.iso_idx]


class Camera:
    """camstream's text control channel."""

    def __init__(self):
        self.ev_pos = 0
        self.mm = None
        self.last_frames = -1

    # --- control ---
    def send(self, line):
        try:
            fd = os.open(CTL, os.O_WRONLY | os.O_NONBLOCK)
        except OSError:
            return False
        try:
            os.write(fd, (line + "\n").encode())
        finally:
            os.close(fd)
        return True

    def events(self):
        try:
            size = os.path.getsize(EVENTS)
            if size < self.ev_pos:
                self.ev_pos = 0
            with open(EVENTS) as handle:
                handle.seek(self.ev_pos)
                text = handle.read()
                self.ev_pos = handle.tell()
        except OSError:
            return []
        return [line.split() for line in text.splitlines() if line.strip()]

    # --- frames ---
    def open_frames(self):
        try:
            with open(FRAME, "rb") as handle:
                self.mm = mmap.mmap(handle.fileno(), 0, prot=mmap.PROT_READ)
        except (OSError, ValueError):
            self.mm = None
        self.last_frames = -1

    def grab(self):
        """Newest NV21 frame as (y, bgr) or None."""
        mm = self.mm
        if mm is None or len(mm) < 32:
            return None
        magic, _ver, width, height, _fmt, seq, size, frames = struct.unpack_from("<8I", mm, 0)
        if magic != 0x4d41434c or frames == self.last_frames or seq & 1:
            return None
        data = bytes(mm[32:32 + size])
        if struct.unpack_from("<I", mm, 20)[0] != seq:
            return None
        self.last_frames = frames
        yuv = np.frombuffer(data, np.uint8).reshape(height * 3 // 2, width)
        return yuv[:height], cv2.cvtColor(yuv, cv2.COLOR_YUV2BGR_NV21)


class Level:
    """Roll angle (degrees) from the sensor hub's accelerometer input device."""

    def __init__(self, on_change):
        self.roll = 0.0
        self.valid = False
        self.on_change = on_change
        self.accel = [0, -256, 0]
        self.fd = None
        for entry in sorted(os.listdir("/sys/class/input")):
            if not entry.startswith("input"):
                continue
            try:
                with open(f"/sys/class/input/{entry}/name") as handle:
                    if "accelerometer" not in handle.read():
                        continue
                for node in os.listdir(f"/sys/class/input/{entry}"):
                    if node.startswith("event"):
                        self.fd = os.open(f"/dev/input/{node}", os.O_RDONLY | os.O_NONBLOCK)
                        GLib.io_add_watch(self.fd, GLib.IO_IN, self.readable)
                        return
            except OSError:
                pass

    def readable(self, _fd, _cond):
        try:
            data = os.read(self.fd, EVENT_SIZE * 32)
        except OSError:
            return True
        for offset in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE):
            _sec, _usec, etype, code, value = struct.unpack_from("<qqHHi", data, offset)
            if etype == 3 and code < 3:
                self.accel[code] = value
        ax, ay, _az = self.accel
        if abs(ax) + abs(ay) > 60:
            roll = math.degrees(math.atan2(ax, -ay))
            self.roll = roll if not self.valid else self.roll * 0.7 + roll * 0.3
            self.valid = True
            self.on_change()
        return True


class Viewfinder(Gtk.DrawingArea):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.surface = None
        self.pixels = None
        self.overlay = None          # zebra / peaking RGBA
        self.overlay_pixels = None
        self.hist = None
        self.frame_size = (480, 640)
        self.focus_ring = None       # (x, y, time)
        self.countdown = ""
        self.banner = ""
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        self.connect("draw", self.on_draw)
        self.connect("button-press-event", self.on_press)
        self.stripes = None

    def on_press(self, _widget, event):
        self.focus_ring = (event.x, event.y, time.monotonic())
        self.app.tap_focus()
        self.queue_draw()
        return True

    def set_frame(self, bgr, y):
        rot = self.app.rotation()
        mirror = self.app.mirror()
        if rot:
            code = {90: cv2.ROTATE_90_CLOCKWISE, 180: cv2.ROTATE_180,
                    270: cv2.ROTATE_90_COUNTERCLOCKWISE}[rot]
            bgr = cv2.rotate(bgr, code)
            y = cv2.rotate(y, code)
        if mirror:
            bgr = cv2.flip(bgr, 1)
            y = cv2.flip(y, 1)
        gain = self.app.preview_gain()
        if gain != 1.0:
            bgr = cv2.convertScaleAbs(bgr, alpha=gain)
        height, width = bgr.shape[:2]
        self.frame_size = (width, height)
        self.pixels = cv2.cvtColor(bgr, cv2.COLOR_BGR2BGRA)
        self.surface = cairo.ImageSurface.create_for_data(
            self.pixels, cairo.FORMAT_RGB24, width, height, self.pixels.strides[0])
        s = self.app.s
        if s.zebra or s.peak:
            over = np.zeros((height, width, 4), np.uint8)
            if s.peak:
                blur = cv2.GaussianBlur(y, (5, 5), 0)
                edge = np.abs(cv2.Laplacian(blur, cv2.CV_16S, ksize=3))
                # only the sharpest ~3 % of the frame, never plain sensor noise
                mask = edge > max(18, np.percentile(edge[::4, ::4], 97))
                over[mask] = (146, 111, 235, 255)  # BGRA of #eb6f92 (love)
            if s.zebra:
                if self.stripes is None or self.stripes.shape != (height, width):
                    yy, xx = np.mgrid[0:height, 0:width]
                    self.stripes = ((xx + yy) // 6) % 2 == 0
                mask = (y >= 250) & self.stripes
                over[mask] = (255, 255, 255, 230)
                low = (y <= 4) & self.stripes
                over[low] = (250, 170, 90, 200)
            self.overlay_pixels = over
            self.overlay = cairo.ImageSurface.create_for_data(
                over, cairo.FORMAT_ARGB32, width, height, over.strides[0])
        else:
            self.overlay = None
        if s.hist:
            small = cv2.resize(bgr, (160, int(160 * height / width)), interpolation=cv2.INTER_AREA)
            self.hist = []
            for channel in range(3):
                values = cv2.calcHist([small], [channel], None, [64], [0, 256]).flatten()
                self.hist.append(values)
        self.queue_draw()

    # --- drawing ---
    def image_rect(self):
        alloc = self.get_allocation()
        fw, fh = self.frame_size
        scale = min(alloc.width / fw, alloc.height / fh)
        w, h = fw * scale, fh * scale
        return (alloc.width - w) / 2, (alloc.height - h) / 2, w, h

    def on_draw(self, _widget, cr):
        alloc = self.get_allocation()
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        x, y, w, h = self.image_rect()
        if self.surface is not None:
            cr.save()
            cr.translate(x, y)
            cr.scale(w / self.frame_size[0], h / self.frame_size[1])
            cr.set_source_surface(self.surface, 0, 0)
            cr.get_source().set_filter(cairo.FILTER_BILINEAR)
            cr.paint()
            if self.overlay is not None:
                cr.set_source_surface(self.overlay, 0, 0)
                cr.paint()
            cr.restore()
        s = self.app.s
        self.draw_grid(cr, x, y, w, h, GRIDS[s.grid])
        if s.level:
            self.draw_level(cr, x, y, w, h)
        if s.hist and self.hist:
            self.draw_hist(cr, x + 8, y + h - 62)
        self.draw_readout(cr, x, y, w)
        if self.focus_ring:
            fx, fy, started = self.focus_ring
            age = time.monotonic() - started
            if age < 1.2:
                cr.set_source_rgba(0.96, 0.76, 0.47, 1 - age / 1.2)
                cr.set_line_width(2)
                cr.rectangle(fx - 30 + age * 6, fy - 30 + age * 6, 60 - age * 12, 60 - age * 12)
                cr.stroke()
                GLib.timeout_add(60, self.queue_draw)
            else:
                self.focus_ring = None
        if self.countdown:
            self.draw_text(cr, self.countdown, alloc.width / 2, alloc.height / 2, 72, center=True)
        if self.banner:
            self.draw_text(cr, self.banner, alloc.width / 2, y + h - 12, 13, center=True, box=True)
        return False

    @staticmethod
    def draw_text(cr, text, x, y, size, center=False, box=False, color=(0.88, 0.87, 0.96)):
        cr.select_font_face("sans-serif", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(size)
        ext = cr.text_extents(text)
        tx = x - ext.width / 2 - ext.x_bearing if center else x
        if box:
            cr.set_source_rgba(0.1, 0.09, 0.14, 0.7)
            cr.rectangle(tx - 8, y - ext.height - 6, ext.width + 16, ext.height + 12)
            cr.fill()
        cr.set_source_rgba(*color, 1)
        cr.move_to(tx, y if not center or box else y + ext.height / 2)
        cr.show_text(text)

    def draw_readout(self, cr, x, y, w):
        s = self.app.s
        if s.manual_exp:
            text = f"{fmt_shutter(s.shutter)}  ISO {s.iso}"
        else:
            text = f"AUTO  EV {s.ev / 2:+g}"
        focus = "AF" if s.af else f"MF {fmt_focus(s.focus)}"
        if s.camera == 1:
            focus = "FF"
        text += f"   f/{1.8 if s.camera == 0 else 2.0}   {focus}"
        cr.set_source_rgba(0.1, 0.09, 0.14, 0.6)
        cr.rectangle(x, y, w, 22)
        cr.fill()
        self.draw_text(cr, text, x + 8, y + 16, 12)

    def draw_hist(self, cr, x, y):
        width, height = 120, 54
        cr.set_source_rgba(0.1, 0.09, 0.14, 0.55)
        cr.rectangle(x, y, width, height)
        cr.fill()
        peak = max(float(np.max(c[1:-1])) for c in self.hist) or 1.0
        colors = [(0.4, 0.6, 1.0), (0.4, 1.0, 0.5), (1.0, 0.4, 0.4)]  # B, G, R
        for values, color in zip(self.hist, colors):
            cr.set_source_rgba(*color, 0.55)
            cr.move_to(x, y + height)
            for index, value in enumerate(values):
                cr.line_to(x + width * index / (len(values) - 1),
                           y + height - height * min(value / peak, 1.0))
            cr.line_to(x + width, y + height)
            cr.close_path()
            cr.fill()

    def draw_grid(self, cr, x, y, w, h, kind):
        if kind == "off":
            return
        cr.set_line_width(1)
        cr.set_source_rgba(1, 1, 1, 0.55)

        def line(x1, y1, x2, y2):
            cr.move_to(x + x1 * w, y + y1 * h)
            cr.line_to(x + x2 * w, y + y2 * h)
            cr.stroke()

        def frame(aspect):
            # aspect = width/height of the frame laid in the portrait view
            fh = min(1.0, (w / aspect) / h)
            fw = min(1.0, (h * aspect) / w)
            fx, fy = (1 - fw) / 2, (1 - fh) / 2
            cr.set_source_rgba(0.1, 0.09, 0.14, 0.55)
            cr.rectangle(x, y, w, h)
            cr.rectangle(x + fx * w, y + fy * h, fw * w, fh * h)
            cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, 0.55)
            return fx, fy, fw, fh

        if kind == "thirds":
            for f in (1 / 3, 2 / 3):
                line(f, 0, f, 1)
                line(0, f, 1, f)
        elif kind == "phi":
            for f in (0.382, 0.618):
                line(f, 0, f, 1)
                line(0, f, 1, f)
        elif kind == "diagonal":
            line(0, 0, 1, 1)
            line(0, 1, 1, 0)
            line(0.5, 0, 0.5, 1)
            line(0, 0.5, 1, 0.5)
        elif kind == "centre":
            line(0.5, 0.42, 0.5, 0.58)
            line(0.42, 0.5, 0.58, 0.5)
            cr.arc(x + w / 2, y + h / 2, w * 0.12, 0, 2 * math.pi)
            cr.stroke()
        elif kind in ("1:1", "16:9", "3:2"):
            # portrait phone: 16:9 and 3:2 are held as portrait frames (9:16, 2:3)
            aspect = {"1:1": 1.0, "16:9": 9 / 16, "3:2": 2 / 3}[kind]
            fx, fy, fw, fh = frame(aspect)
            for f in (1 / 3, 2 / 3):
                line(fx + f * fw, fy, fx + f * fw, fy + fh)
                line(fx, fy + f * fh, fx + fw, fy + f * fh)

    def draw_level(self, cr, x, y, w, h):
        lvl = self.app.level
        if not lvl.valid:
            return
        roll = lvl.roll
        if roll > 90:
            roll -= 180
        elif roll < -90:
            roll += 180
        level = abs(roll) < 1.0
        cr.save()
        cr.translate(x + w / 2, y + h / 2)
        cr.set_line_width(2)
        if level:
            cr.set_source_rgba(0.61, 0.81, 0.85, 0.95)  # foam
            cr.move_to(-70, 0)
            cr.line_to(70, 0)
            cr.stroke()
        else:
            cr.set_source_rgba(0.96, 0.76, 0.47, 0.9)  # gold
            cr.rotate(math.radians(-roll))
            cr.move_to(-60, 0)
            cr.line_to(-14, 0)
            cr.move_to(14, 0)
            cr.line_to(60, 0)
            cr.stroke()
            cr.restore()
            cr.save()
            cr.translate(x + w / 2, y + h / 2)
            cr.set_source_rgba(1, 1, 1, 0.6)
            cr.set_line_width(1)
            cr.move_to(-30, 0)
            cr.line_to(30, 0)
            cr.stroke()
        cr.restore()


class Task:
    """Generator-driven background job: yields ("wait", seconds) or ("shot", path)."""

    def __init__(self, app, gen):
        self.app = app
        self.gen = gen
        self.wait_until = 0
        self.result = None
        self.cancelled = False
        GLib.timeout_add(40, self.step)

    def step(self):
        if self.cancelled:
            return False
        now = time.monotonic()
        if now < self.wait_until:
            return True
        try:
            request = self.gen.send(self.result)
        except StopIteration:
            return False
        self.result = None
        if request[0] == "wait":
            self.wait_until = now + request[1]
        elif request[0] == "shot":
            self.app.pending_shot = request[1]
            self.app.shot_result = None
            self.wait_until = 0
            # polled below
            GLib.timeout_add(50, self.poll_shot)
            return False
        return True

    def poll_shot(self):
        if self.app.shot_result is None:
            return True
        self.result = self.app.shot_result
        self.app.shot_result = None
        GLib.timeout_add(40, self.step)
        return False


class ProCamera(Gtk.Window):
    def __init__(self):
        super().__init__(title="Camera")
        self.get_style_context().add_class("cam")
        self.s = Settings()
        self.s.load()
        self.cam = Camera()
        self.ready = False
        self.starting = False
        self.busy = False
        self.pending_shot = None
        self.shot_result = None
        self.task = None
        self.last_photo = None
        self.set_timer = None
        self.level = Level(lambda: self.view.queue_draw() if self.s.level else None)
        self.panel = "shutter"
        os.makedirs(PHOTO_DIR, exist_ok=True)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(outer)

        # top toggles
        top = Gtk.Box(spacing=3, homogeneous=True)
        top.set_margin_start(6)
        top.set_margin_end(6)
        top.set_margin_top(4)
        top.set_margin_bottom(4)
        self.toggles = {}
        for key, label in [("flip", "FLIP"), ("grid", "GRID"), ("hist", "HIST"), ("zebra", "ZEBRA"),
                           ("peak", "PEAK"), ("level", "LEVEL"), ("enhance", "ENH")]:
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("chip")
            button.set_hexpand(True)
            button.connect("clicked", self.on_toggle, key)
            top.pack_start(button, True, True, 0)
            self.toggles[key] = button
        outer.pack_start(top, False, False, 0)

        self.view = Viewfinder(self)
        self.view.set_size_request(360, 480)
        self.view.set_vexpand(True)
        outer.pack_start(self.view, True, True, 0)

        # pro rows
        self.pro_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.pro_box.set_margin_start(6)
        self.pro_box.set_margin_end(6)
        self.pro_box.set_margin_top(4)
