# Forked from Alpine aports community/wlroots0.20 for the Moto G06 (lagos):
# 0100-*.patch lets sway turn the display back on after DPMS off (the
# MediaTek DRM driver has no gamma ioctl). Keep pkgver in sync with Alpine;
# pkgrel stays above theirs.
# Contributor: Henrik Riomar <henrik.riomar@gmail.com>
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=wlroots0.20
pkgver=0.20.2
_pkgver=${pkgver/_/-}
pkgrel=100
pkgdesc="Modular Wayland compositor library"
url="https://gitlab.freedesktop.org/wlroots/wlroots"
license="MIT"
arch="all"
makedepends="
	eudev-dev
	glslang-dev
	hwdata-dev
	libcap-dev
	libdisplay-info-dev
	libinput-dev
	libseat-dev
	libliftoff-dev
	libxcb-dev
	libxkbcommon-dev
	lcms2-dev
	mesa-dev
	meson
	ninja
	pixman-dev
	vulkan-loader-dev
	wayland-dev
	wayland-protocols
	xcb-util-image-dev
	xcb-util-renderutil-dev
	xcb-util-wm-dev
	xkeyboard-config-dev
	xwayland-dev
	"
# wlroots >= 0.18.0 does no longer ship a libwlroots.so symlink in the -dev
# subpackage. Hence, abuild's dependency tracing fails to identify that the
# -dev subpackage depends on the origin package and we need to add that
# manually. Otherwise, the wlroots shared object is not installed with -dev.
depends_dev="$pkgname=$pkgver-r$pkgrel"
subpackages="$pkgname-dbg $pkgname-static $pkgname-dev"
source="https://gitlab.freedesktop.org/wlroots/wlroots/-/archive/$_pkgver/wlroots-$_pkgver.tar.gz
	e8c983808d8b98a71f991c16c24367494386958b.patch
	0100-drm-legacy-gamma-reset-enosys.patch
	"
builddir="$srcdir/wlroots-$_pkgver"
# No test suite; crossdirect's cc can't spawn cc1 in this buildroot
options="!check !pmb:crossdirect"

# whether this is the default version (latest stable wlroots)
_default="yes"

if [ "$_default" = yes ]; then
	provides="wlroots=$pkgver-r$pkgrel"
	replaces="wlroots"

	dev() {
		default_dev
		provides="wlroots-dev=$pkgver-r$pkgrel"
		replaces="wlroots-dev"
	}
fi

build() {
	abuild-meson \
		-Db_lto=true \
		-Dexamples=false \
		-Dcolor-management=enabled \
		-Ddefault_library=both \
		. build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
}

sha512sums="
e96523a2b215e7d1f36bbe5e7fa3e65d15cb87e2f0d9c304d3c2fdc81b0ac0c7202cd955635c01072b34e70f08c6c00fa2cde8c277bd73fcabdcb19f7b579a12  wlroots-0.20.2.tar.gz
6e7085db75075673b9ad25386eb9a83bb6c311b743f0c879f6ba1616b11d1ceb6067f555cd0e4a65fcfa1c10b707ae421415edf5fe5c77b613adf0fae805f2dc  e8c983808d8b98a71f991c16c24367494386958b.patch
bd0c7ce9dbb038b5d901f9f5e20df4364bbf28d56cfefb9cf16038f545e0ad1da84fe77d534afbadcd05ce863bf191f5bb45ea486fb7e47c31f83740ad540bf0  0100-drm-legacy-gamma-reset-enosys.patch
"
