From a1a66babb3c7f0b95ceada442bbb00131941aed6 Mon Sep 17 00:00:00 2001
From: nikuzo <buelaniki@gmail.com>
Date: Sat, 26 Sep 2026 17:29:53 -0300
Subject: [PATCH] backend/drm: treat a legacy gamma reset on drivers without
 gamma as done

MediaTek's vendor DRM driver reports a legacy gamma size but doesn't
implement DRM_IOCTL_MODE_SETGAMMA (ENOSYS). Resetting the gamma LUT then
failed, and with it every output commit that included a color transform
reset, such as sway re-enabling an output after DPMS off: the display
stayed off. There's nothing to reset on such hardware, so succeed.
---
 backend/drm/legacy.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/backend/drm/legacy.c b/backend/drm/legacy.c
index 223852e..f05d24f 100644
--- a/backend/drm/legacy.c
+++ b/backend/drm/legacy.c
@@ -1,4 +1,5 @@
 #include <assert.h>
+#include <errno.h>
 #include <stdlib.h>
 #include <wlr/util/log.h>
 #include <xf86drm.h>
@@ -271,6 +272,14 @@ bool drm_legacy_crtc_set_gamma(struct wlr_drm_backend *drm,
 
 	uint16_t *r = lut, *g = lut + size, *b = lut + 2 * size;
 	if (drmModeCrtcSetGamma(drm->fd, crtc->id, size, r, g, b) != 0) {
+		// Some drivers (e.g. MediaTek's vendor DRM) report a gamma size but
+		// don't implement the ioctl: there's no gamma to reset there
+		if (linear_lut != NULL && (errno == ENOSYS || errno == EOPNOTSUPP)) {
+			wlr_log(WLR_DEBUG, "CRTC %"PRIu32" has no gamma support, "
+				"skipping gamma reset", crtc->id);
+			free(linear_lut);
+			return true;
+		}
 		wlr_log_errno(WLR_ERROR, "Failed to set gamma LUT on CRTC %"PRIu32,
 			crtc->id);
 		free(linear_lut);
-- 
2.55.0

