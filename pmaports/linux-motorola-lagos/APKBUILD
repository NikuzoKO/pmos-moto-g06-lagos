f05e6dd09153773b44efef1e2fcf7dd93e1e91feaf95697d2f5f6cc8ba03bb36c724edb92176a804308aed722fdc89e25e9067df6cc837efcc1a395fcc14265b  config-motorola-lagos.aarch64
aacc2448a5deed39dc9965985c2cacfdf6a14f3401a054ee91fa5481a97bd825749a457ab634457ffa46056526f47b957a4b2660dd886858d4ced39b98a62356  remove-stale-compiler-gcc-guard.patch
"
