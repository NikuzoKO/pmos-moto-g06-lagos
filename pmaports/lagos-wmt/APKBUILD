pkgname=lagos-wmt
pkgver=1
pkgrel=2
pkgdesc="Open stand-in for MediaTek's Android wmt_loader/wmt_launcher (MT6768 connsys)"
url="https://github.com/NikuzoKO/pmos-moto-g06-lagos"
arch="aarch64"
license="MIT"
source="lagos-wmt.c"
makedepends="gcc musl-dev"
# crossdirect's cc fails to spawn cc1 in the aarch64 build root here
options="!check !pmb:crossdirect"

build() {
	${CC:-gcc} $CFLAGS -Wall -o lagos-wmt "$srcdir"/lagos-wmt.c $LDFLAGS
}

package() {
	install -Dm755 lagos-wmt "$pkgdir"/usr/bin/lagos-wmt
}
sha512sums="
6e68f6c7a75460ae71a15176148f39c443f8d7f4f1aa99f194e63428558725da59d4e6c314737f73c5edb8d719609643319ea5499066dd9adf417c8c2934f5c2  lagos-wmt.c
"
