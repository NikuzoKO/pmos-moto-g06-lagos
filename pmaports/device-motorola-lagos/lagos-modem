#!/bin/sh
# Boot the MT6768 modem with MediaTek's own ccci_mdinit and ccci_rpcd,
# running in the Android root (lagos-android-root.service).
#
# LK already loaded the modem image; the kernel only accepts the start ioctl
# from a process named "ccci_mdinit", whose fsd thread then serves the
# modem's NVRAM from the nvdata/protect partitions. ccci_rpcd must run too,
# or the modem stops at the second boot handshake.

set -e

# The CCIF/CLDMA transports own the mailbox clocks: without them the modem
# polls a gated CCIF0 and floods Device APC violations
modprobe -a ccci_cldma ccci_ccif ccci_fsm_scp

lagos-android-run /vendor/bin/ccci_rpcd 0 &
exec lagos-android-run /vendor/bin/ccci_mdinit 0
