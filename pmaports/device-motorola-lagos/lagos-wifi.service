[Unit]
# LK boots into power-off charging mode (bootmode 8) when a charger switches
# the phone on; the connectivity and modem drivers refuse to init there
ConditionKernelCommandLine=!oem_devinfo.bootmode=8
Description=Switch on the MT6768 WiFi (station mode)
Requires=lagos-wmt.service
After=lagos-wmt.service
Before=NetworkManager.service
ConditionPathExists=/usr/lib/modules/%v/vendor_dlkm/wlan_drv_gen4m_6768.ko

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/sbin/modprobe -a wmt_chrdev_wifi wlan_drv_gen4m_6768
ExecStartPre=/usr/bin/lagos-nvdata WIFI
ExecStart=/usr/bin/lagos-wmt wifi-on /var/lib/lagos/nvdata/WIFI

[Install]
WantedBy=multi-user.target
