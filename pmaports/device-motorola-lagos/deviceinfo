# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Motorola Moto G06"
deviceinfo_manufacturer="Motorola"
deviceinfo_codename="motorola-lagos"
deviceinfo_year="2025"
deviceinfo_dtb="lagos-stock"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"

# Bootloader related
deviceinfo_flash_method="fastboot"
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="4096"
deviceinfo_bootimg_qcdt="false"
deviceinfo_header_version="4"

# Load addresses from the stock vendor_boot_a header (mkbootimg defaults at
# 0x10000000 are not DRAM here; LK fails mblock_reserve and asserts in mt_boot.c)
deviceinfo_flash_offset_base="0x40000000"
deviceinfo_flash_offset_kernel="0x00080000"
deviceinfo_flash_offset_ramdisk="0x07c80000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x0bc80000"
deviceinfo_flash_offset_dtb="0x0bc80000"
# boot-deploy's header v3/v4 mkbootimg call ignores flash_offset_*, so pass
# the stock vendor_boot load addresses explicitly
deviceinfo_bootimg_custom_args="--base 0x40000000 --kernel_offset 0x00080000 --ramdisk_offset 0x07c80000 --tags_offset 0x0bc80000 --dtb_offset 0x0bc80000"
