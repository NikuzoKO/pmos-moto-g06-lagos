# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-motorola-lagos
pkgver=1
pkgrel=7
pkgdesc="Motorola Moto G06"
url="https://postmarketos.org"
arch="aarch64"
license="MIT"
depends="
	android-tools-mkbootimg
	lagos-wmt
	linux-motorola-lagos
	postmarketos-base
	postmarketos-base-downstream
	"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	lagos-stock.dtb
	lagos-backlight-resend
	lagos-backlight-resend.service
	90-lagos.preset
	lagos-mknod
	00-lagos-mknod.rules
	lagos-touch.service
	lagos-audio.service
	lagos-run-lock.conf
	tinydm-lagos-novt.conf
	lagos-audio-setup
	71-lagos-audio.rules
	pipewire-lagos-speaker.conf
	alsa-lagos-skip.conf
	lagos-wmt.service
	lagos-wifi.service
	lagos-wifi-nvram
	sxmo-deviceprofile-lagos.sh
	"
options="!archcheck !check"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Stock MTK dt_table blob from vendor_boot_a; LK reads it from vendor_boot's dtb section
	install -Dm644 "$srcdir"/lagos-stock.dtb "$pkgdir"/usr/share/dtb/lagos-stock.dtb

	install -Dm755 "$srcdir"/lagos-backlight-resend "$pkgdir"/usr/bin/lagos-backlight-resend
	install -Dm644 "$srcdir"/lagos-backlight-resend.service \
		"$pkgdir"/usr/lib/systemd/system/lagos-backlight-resend.service
	install -Dm644 "$srcdir"/90-lagos.preset "$pkgdir"/usr/lib/systemd/system-preset/90-lagos.preset

	install -Dm755 "$srcdir"/lagos-mknod "$pkgdir"/usr/bin/lagos-mknod
	install -Dm644 "$srcdir"/00-lagos-mknod.rules "$pkgdir"/usr/lib/udev/rules.d/00-lagos-mknod.rules

	install -Dm644 "$srcdir"/lagos-touch.service "$pkgdir"/usr/lib/systemd/system/lagos-touch.service
	install -Dm644 "$srcdir"/lagos-audio.service "$pkgdir"/usr/lib/systemd/system/lagos-audio.service
	install -Dm755 "$srcdir"/lagos-audio-setup "$pkgdir"/usr/bin/lagos-audio-setup
	install -Dm644 "$srcdir"/71-lagos-audio.rules "$pkgdir"/usr/lib/udev/rules.d/71-lagos-audio.rules
	install -Dm644 "$srcdir"/pipewire-lagos-speaker.conf \
		"$pkgdir"/usr/share/pipewire/pipewire.conf.d/50-lagos-speaker.conf
	local unit
	for unit in alsa-restore alsa-state; do
		install -Dm644 "$srcdir"/alsa-lagos-skip.conf \
			"$pkgdir"/usr/lib/systemd/system/$unit.service.d/lagos-skip.conf
	done

	install -Dm755 "$srcdir"/lagos-wifi-nvram "$pkgdir"/usr/bin/lagos-wifi-nvram
	install -Dm644 "$srcdir"/lagos-wmt.service "$pkgdir"/usr/lib/systemd/system/lagos-wmt.service
	install -Dm644 "$srcdir"/lagos-wifi.service "$pkgdir"/usr/lib/systemd/system/lagos-wifi.service

	# sxmo finds it by the first DT compatible; abuild won't take a comma in
	# a source file name
	install -Dm755 "$srcdir"/sxmo-deviceprofile-lagos.sh \
		"$pkgdir"/usr/bin/sxmo_deviceprofile_mediatek,MT6768.sh

	# No tmpfiles rule creates it on this systemd build; alsactl needs it for its lock
	install -Dm644 "$srcdir"/lagos-run-lock.conf "$pkgdir"/usr/lib/tmpfiles.d/lagos-run-lock.conf
	install -Dm644 "$srcdir"/tinydm-lagos-novt.conf \
		"$pkgdir"/usr/lib/systemd/system/tinydm.service.d/lagos-novt.conf
}

