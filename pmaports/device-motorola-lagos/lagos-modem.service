[Unit]
Description=Boot the MT6768 modem (stock ccci_mdinit + ccci_rpcd)
# The Android root holds stock vendor binaries that aren't redistributable:
# build it from your own phone's images (see README)
ConditionPathExists=/var/lib/lagos/android/vendor/bin/ccci_mdinit
After=systemd-udevd.service
Before=ModemManager.service

[Service]
Type=simple
ExecStart=/usr/bin/lagos-modem
# Only count as started once the modem is ready (md1:4), so ModemManager
# doesn't probe ttyC0 while it's still booting
ExecStartPost=/bin/sh -c 'for i in $(seq 120); do grep -q "md1:4" /sys/kernel/ccci/boot && exit 0; sleep 0.5; done; exit 1'
TimeoutStartSec=90
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
