[Unit]
Description=Prepare the Android root for the stock MediaTek daemons
# The Android root holds stock vendor binaries that aren't redistributable:
# build it from your own phone's images (see README)
# (linker64 in system/bin is an absolute symlink that only resolves inside
# the chroot, so check the real file)
ConditionPathExists=/var/lib/lagos/android/apex/com.android.runtime/bin/linker64
After=systemd-udevd.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/lagos-android-root
