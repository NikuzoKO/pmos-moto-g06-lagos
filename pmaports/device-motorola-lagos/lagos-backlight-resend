#!/bin/sh
# React to the panel powering up and down:
# - The backlight is set by a DSI command, which the LED core only sends when
#   the brightness value changes. After the display powers up again it stays
#   dark, so re-send the current level once the panel is prepared.
# - Like Android on screen off/on, switch the WiFi firmware's suspend mode,
#   which drops multicast so LAN chatter doesn't keep waking the phone.

BRIGHTNESS=/sys/class/leds/lcd-backlight/brightness

resend_brightness() {
	current=$(cat "$BRIGHTNESS")
	[ "$current" -gt 0 ] || return 0
	if [ "$current" -gt 1 ]; then
		nudged=$((current - 1))
	else
		nudged=$((current + 1))
	fi
	echo "$nudged" > "$BRIGHTNESS"
	echo "$current" > "$BRIGHTNESS"
}

journalctl -k -f -n0 -o cat | while read -r line; do
	case "$line" in
	*mtk_drm_crtc_atomic_resume*)
		lagos-wmt wifi-suspend-mode 0 &
		;;
	*"tianma_prepare -"*)
		# the panel has finished its power-up sequence
		sleep 0.05
		resend_brightness
		;;
	*"tianma_unprepare +"*)
		lagos-wmt wifi-suspend-mode 1 &
		;;
	esac
done
