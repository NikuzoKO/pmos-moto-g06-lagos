#!/bin/sh
# Without a Wake-on-WLAN config, cfg80211 disconnects every network on
# suspend, so the phone dropped off WiFi each time it slept. Keep the link
# up and wake on any traffic instead.
for phy in /sys/class/ieee80211/*; do
	[ -e "$phy" ] || continue
	iw phy "$(basename "$phy")" wowlan enable any
done
