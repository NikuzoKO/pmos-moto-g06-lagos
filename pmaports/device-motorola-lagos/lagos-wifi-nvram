#!/bin/sh
# Copy this phone's WiFi NVRAM (MAC address, RF calibration) out of the
# Android nvdata partition once. nvdata is mounted read-only with noload,
# so not even its journal is replayed: it's never written to.
set -e

nvram=/var/lib/lagos/wifi_nvram.bin
[ -s "$nvram" ] && exit 0

mountpoint=$(mktemp -d)
trap 'umount "$mountpoint" 2>/dev/null; rmdir "$mountpoint"' EXIT
mount -t ext4 -o ro,noload /dev/disk/by-partlabel/nvdata "$mountpoint"
install -Dm600 "$mountpoint"/APCFG/APRDEB/WIFI "$nvram"
