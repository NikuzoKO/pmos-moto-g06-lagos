pkgname=lagos-sensord
pkgver=1
pkgrel=0
pkgdesc="Bridge the MT6768 (SCP) sensor hub to Linux input devices for iio-sensor-proxy"
url="https://github.com/NikuzoKO/pmos-moto-g06-lagos"
arch="aarch64"
license="MIT"
depends="iio-sensor-proxy"
source="lagos-sensord.c lagos-sensord.service"
makedepends="gcc musl-dev linux-headers"
# crossdirect's cc fails to spawn cc1 in the aarch64 build root here
options="!check !pmb:crossdirect"

build() {
	${CC:-gcc} $CFLAGS -Wall -o lagos-sensord "$srcdir"/lagos-sensord.c $LDFLAGS
}

package() {
	install -Dm755 lagos-sensord "$pkgdir"/usr/bin/lagos-sensord
	install -Dm644 "$srcdir"/lagos-sensord.service \
		"$pkgdir"/usr/lib/systemd/system/lagos-sensord.service
}
sha512sums="
