# Forked from Alpine aports community/waydroid for the Moto G06 (lagos). The
# stock GKI kernel has no PID, IPC, user or cgroup namespaces:
# 0100-*.patch shares the host namespaces, mounts cgroup2 rw, hands Android a
# prebuilt cgroup map (cgroup.rc; libprocessgroup only builds it as PID 1),
# tolerates the missing xt_CHECKSUM and forces lmkd's new strategy.
# pid_max is capped at 32768 (32-bit bionic mutexes keep a 16-bit owner TID).
# A container stop leaves Android's userspace running: run waydroid-reap after.
# Keep pkgver in sync with Alpine; pkgrel stays above theirs.
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=waydroid
pkgver=1.6.3
pkgrel=100
pkgdesc="A container-based approach to boot a full Android system on a regular Linux system"
url="https://github.com/waydroid/waydroid"
# Only x86, armv7, x86_64 and aarch64 supported upstream
arch="noarch !armhf !ppc64le !s390x"
license="GPL-3.0-only"
depends="
	dnsmasq
	gbinder-python
	iptables
	kmod
	lxc
	py3-dbus
	py3-gobject3
	py3-pyclip
	python3
	"
makedepends="coreutils"
triggers="$pkgname.trigger=/usr/share/waydroid-extra/images"
install="$pkgname.post-upgrade"
subpackages="
	$pkgname-openrc
	$pkgname-pyc
	$pkgname-nftrules::noarch
	$pkgname-systemd
	"
source="https://github.com/waydroid/waydroid/archive/$pkgver/waydroid-$pkgver.tar.gz
	waydroid-container.initd
	waydroid-container.confd
	51_waydroid.nft
	waydroid-session.desktop
	0100-lagos-no-pid-namespace.patch
	cgroup.rc
	waydroid-reap.sh
	60-waydroid-pid-max.conf
	"
options="!check" # No tests

package() {
	make DESTDIR="$pkgdir" USE_SYSTEMD=1 USE_NFTABLES=1 install

	# Generate __pycache__ packaging time instead of runtime
	python -m compileall "$pkgdir"/usr/lib/waydroid/tools

	install -Dm644 -t "$pkgdir"/etc/xdg/autostart "$srcdir"/waydroid-session.desktop

	install -Dm755 "$srcdir"/waydroid-container.initd "$pkgdir"/etc/init.d/waydroid-container
	install -Dm644 "$srcdir"/waydroid-container.confd "$pkgdir"/etc/conf.d/waydroid-container

	install -Dm644 "$srcdir"/51_waydroid.nft \
		"$pkgdir"/usr/share/nftables.avail/51_waydroid.nft

	# cgroup.rc (Android 13 format): u32 version=1, u32 count, then per
	# controller u32 version, u32 flags (1 = mounted), char name[16],
	# char path[32]; entries: cgroup2 and freezer, both at /sys/fs/cgroup
	install -Dm644 "$srcdir"/cgroup.rc \
		"$pkgdir"/usr/lib/waydroid/data/cgroup_info/cgroup.rc
	install -Dm755 "$srcdir"/waydroid-reap.sh "$pkgdir"/usr/bin/waydroid-reap
	install -Dm644 -t "$pkgdir"/usr/lib/sysctl.d "$srcdir"/60-waydroid-pid-max.conf
}

pyc() {
	default_pyc

	cd "$pkgdir"
	local IFS=$'\n'
	amove $(find usr/lib/waydroid -type d -name __pycache__)
}

