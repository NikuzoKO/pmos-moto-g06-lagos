--- a/data/configs/config_base
+++ b/data/configs/config_base
@@ -7,7 +7,8 @@
 
 lxc.cap.keep = audit_control sys_nice wake_alarm setpcap setgid setuid sys_ptrace sys_admin wake_alarm block_suspend sys_time net_admin net_raw net_bind_service kill dac_override dac_read_search fsetid mknod syslog chown sys_resource fowner ipc_lock sys_chroot
 
-lxc.mount.auto = cgroup:ro sys:ro proc
+# no cgroup namespace in the stock kernel: Android must create its process groups
+lxc.mount.auto = cgroup:rw sys:ro proc
 
 lxc.console.path = none
 
@@ -16,3 +17,9 @@
 
 lxc.hook.post-stop = /dev/null
 
+
+# The stock GKI kernel has no PID, IPC or user namespaces: share the host's
+lxc.namespace.keep = pid ipc user
+lxc.mount.entry = cgroup2 sys/fs/cgroup cgroup2 rw,nosuid,nodev,noexec 0 0
+# Android sets up cgroups only as PID 1 (no PID namespace here): provide its map
+lxc.mount.entry = /usr/lib/waydroid/data/cgroup_info dev/cgroup_info none bind,create=dir 0 0
