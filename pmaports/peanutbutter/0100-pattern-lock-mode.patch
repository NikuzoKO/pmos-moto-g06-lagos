index 0000000..c7c8e9e
--- /dev/null
+++ b/src/pattern.rs
@@ -0,0 +1,185 @@
+// Pattern lock: a visible 3x3 grid of dots, unlocked by swiping through them in
+// order. The passcode uses the same digits as the 3x3 touch grid
+// (1 = topleft, 5 = center, 9 = bottomright).
+
+const GRID: usize = 3;
+
+pub enum Outcome {
+    Valid,
+    Invalid,
+}
+
+#[derive(Clone, Debug)]
+pub struct PatternState {
+    passcode: Vec<u8>,
+    path: Vec<u8>,
+    finger: Option<(f64, f64)>,
+    dots: [(f64, f64); GRID * GRID],
+    spacing: f64,
+    tries: usize,
+    max_tries: u16,
+    failed: bool,
+}
+
+/// Like Android: going straight from one dot to another across a dot halfway
+/// between them picks that dot up too, if it isn't part of the path yet
+fn push_dot(path: &mut Vec<u8>, code: u8) {
+    if let Some(&previous) = path.last() {
+        let (previous_row, previous_column) = ((previous - 1) / 3, (previous - 1) % 3);
+        let (row, column) = ((code - 1) / 3, (code - 1) % 3);
+        if (previous_row + row) % 2 == 0 && (previous_column + column) % 2 == 0 {
+            let middle = (previous_row + row) / 2 * 3 + (previous_column + column) / 2 + 1;
+            if middle != previous && middle != code && !path.contains(&middle) {
+                path.push(middle);
+            }
+        }
+    }
+    path.push(code);
+}
+
+/// The passcode as it gets swiped: "7593" crosses 6 on the way from 9 to 3,
+/// so it means 7-5-9-6-3, same as "75963"
+fn read_passcode(passcode: &str) -> Vec<u8> {
+    let mut path = Vec::new();
+    for character in passcode.chars() {
+        let code = match character.to_digit(10) {
+            Some(digit @ 1..=9) => digit as u8,
+            _ => panic!("invalid pattern passcode: use digits 1 (topleft) to 9 (bottomright)"),
+        };
+        if path.contains(&code) {
+            panic!("invalid pattern passcode: a dot can only be used once");
+        }
+        push_dot(&mut path, code);
+    }
+    path
+}
+
+impl PatternState {
+    pub fn new(width: i32, height: i32, passcode: Option<&str>, max_tries: u16) -> Self {
+        let mut state = Self {
+            passcode: read_passcode(passcode.expect("pattern mode needs PEANUTBUTTER_PASSCODE")),
+            path: Vec::new(),
+            finger: None,
+            dots: [(0.0, 0.0); GRID * GRID],
+            spacing: 0.0,
+            tries: 0,
+            max_tries,
+            failed: false,
+        };
+        state.resize(width, height);
+        state
+    }
+
+    /// Lay the grid out in the lower part of the screen, below the clock
+    pub fn resize(&mut self, width: i32, height: i32) {
+        let (width, height) = (width as f64, height as f64);
+        self.spacing = (width * 0.28).min(height * 0.16);
+        let center_x = width / 2.0;
+        let center_y = height * 0.66;
+        for (index, dot) in self.dots.iter_mut().enumerate() {
+            let column = (index % GRID) as f64 - 1.0;
+            let row = (index / GRID) as f64 - 1.0;
+            *dot = (center_x + column * self.spacing, center_y + row * self.spacing);
+        }
+    }
+
+    pub fn dots(&self) -> &[(f64, f64)] {
+        &self.dots
+    }
+
+    pub fn spacing(&self) -> f64 {
+        self.spacing
+    }
+
+    /// Dot positions along the current path, in order
+    pub fn path_points(&self) -> Vec<(f64, f64)> {
+        self.path
+            .iter()
+            .map(|code| self.dots[(*code - 1) as usize])
+            .collect()
+    }
+
+    pub fn finger(&self) -> Option<(f64, f64)> {
+        self.finger
+    }
+
+    pub fn is_visited(&self, index: usize) -> bool {
+        self.path.contains(&((index + 1) as u8))
+    }
+
+    pub fn failed(&self) -> bool {
+        self.failed
+    }
+
+    pub fn begin(&mut self, x: f64, y: f64) {
+        if self.permalocked() {
+            return;
+        }
+        self.path.clear();
+        self.failed = false;
+        self.motion(x, y);
+    }
+
+    pub fn motion(&mut self, x: f64, y: f64) {
+        if self.permalocked() {
+            return;
+        }
+        self.finger = Some((x, y));
+        let hit_radius = self.spacing * 0.3;
+        let hit = self.dots.iter().position(|(dot_x, dot_y)| {
+            (dot_x - x).hypot(dot_y - y) <= hit_radius
+        });
+        if let Some(index) = hit {
+            let code = (index + 1) as u8;
+            if !self.path.contains(&code) {
+                push_dot(&mut self.path, code);
+            }
+        }
+    }
+
+    /// Finger lifted: check the pattern. Nothing happens for a stray tap
+    pub fn end(&mut self) -> Option<Outcome> {
+        self.finger = None;
+        if self.permalocked() || self.path.is_empty() {
+            self.path.clear();
+            return None;
+        }
+        if self.path == self.passcode {
+            return Some(Outcome::Valid);
+        }
+        self.failed = true;
+        if self.max_tries != 0 {
+            self.tries += 1;
+        }
+        Some(Outcome::Invalid)
+    }
+
+    /// Clear a failed pattern from the screen
+    pub fn clear(&mut self) {
+        self.path.clear();
+        self.failed = false;
+    }
+
+    pub fn permalocked(&self) -> bool {
+        self.max_tries != 0 && self.tries >= self.max_tries as usize
+    }
+
+    pub fn reset(&mut self) {
+        self.tries = 0;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::read_passcode;
+
+    #[test]
+    fn passcode_picks_up_crossed_dots() {
+        assert_eq!(read_passcode("7593"), vec![7, 5, 9, 6, 3]);
+        assert_eq!(read_passcode("75963"), vec![7, 5, 9, 6, 3]);
+        assert_eq!(read_passcode("13"), vec![1, 2, 3]);
+        assert_eq!(read_passcode("19"), vec![1, 5, 9]);
+        assert_eq!(read_passcode("213"), vec![2, 1, 3]);
+        assert_eq!(read_passcode("16"), vec![1, 6]);
+    }
+}
