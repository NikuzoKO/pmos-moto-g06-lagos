+    /// Dots, the path swiped so far and a line to the finger (all in surface
+    /// coordinates, scaled to the buffer)
+    fn draw_pattern(&self, context: &cairo::Context) {
+        let Some(pattern) = self.pattern.as_ref() else {
+            return;
+        };
+        let scale = self.scale as f64;
+        let spacing = pattern.spacing() * scale;
+        if pattern.failed() {
+            context.set_source_rgb(0.9, 0.2, 0.2);
+        } else {
+            context.set_source_rgb(1.0, 1.0, 1.0);
+        }
+
+        let points = pattern.path_points();
+        if !points.is_empty() {
+            context.set_line_width(spacing * 0.035);
+            context.set_line_cap(cairo::LineCap::Round);
+            context.set_line_join(cairo::LineJoin::Round);
+            context.move_to(points[0].0 * scale, points[0].1 * scale);
+            for (x, y) in points.iter().skip(1) {
+                context.line_to(x * scale, y * scale);
+            }
+            if let Some((x, y)) = pattern.finger() {
+                context.line_to(x * scale, y * scale);
+            }
+            context.stroke().unwrap();
+        }
+
+        for (index, (x, y)) in pattern.dots().iter().enumerate() {
+            let (x, y) = (x * scale, y * scale);
+            context.new_sub_path();
+            context.arc(x, y, spacing * 0.05, 0.0, std::f64::consts::TAU);
+            context.fill().unwrap();
+            if pattern.is_visited(index) {
+                context.set_line_width(spacing * 0.02);
+                context.new_sub_path();
+                context.arc(x, y, spacing * 0.16, 0.0, std::f64::consts::TAU);
+                context.stroke().unwrap();
+            }
+        }
+    }
 }
