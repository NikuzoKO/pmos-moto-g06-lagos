# Forked from Alpine aports community/peanutbutter for the Moto G06 (lagos):
# 0100-*.patch adds a visible swipe-pattern lock (-P), 0102 the Rosé Pine
# palette of the desktop, 0103 a blurred --background PNG and the Claudio alert card drawn above
# the lock (alert.rs, see ~/projects/peanutbutter-claudio). Keep pkgver in sync
# with Alpine; pkgrel stays above theirs.
# Contributor: Anjandev Momi <anjan@momi.ca>
# Maintainer: Anjandev Momi <anjan@momi.ca>
pkgname=peanutbutter
pkgver=0.5.1
pkgrel=104
pkgdesc="A lock screen for linux mobile - specially designed for Sxmo (sway edition)"
url="https://git.sr.ht/~anjan/peanutbutter"
arch="all"
license="AGPL-3.0-only"
makedepends="cargo cargo-auditable glib-dev pango-dev scdoc"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://git.sr.ht/~anjan/peanutbutter/archive/$pkgver.tar.gz
	0100-pattern-lock-mode.patch
	0101-session-lock-finished.patch
	0102-rose-pine-palette.patch
	0103-claudio-background-and-alert-card.patch
	"
# crossdirect's cc can't spawn cc1 in this buildroot
options="!check !pmb:crossdirect"

# pmbootstrap points RUSTC_WRAPPER at sccache, which isn't in the buildroot
unset RUSTC_WRAPPER

prepare() {
	default_prepare

	cargo fetch --target="$CTARGET" --locked
}

build() {
	cargo auditable build --frozen --release
	scdoc < docs/peanutbutter.1.scd > peanutbutter.1
}

package() {
	install -Dm755 target/release/peanutbutter \
		-t "$pkgdir"/usr/bin/

	install -Dm644 peanutbutter.1 -t "$pkgdir"/usr/share/man/man1/
}

