+/// Everything one frame needs, so it can be rendered without a Wayland connection
+/// (the real lock and the offscreen `--preview` share this).
+pub struct Frame<'a> {
+    pub width: i32,  // buffer pixels
+    pub height: i32, // buffer pixels
+    pub scale: i32,
+    pub fontdesc_time: &'a pango::FontDescription,
+    pub fontdesc_status: &'a pango::FontDescription,
+    pub status: &'a str,
+    pub time: chrono::DateTime<chrono::Local>,
+    pub inverted: bool,
+    pub permalocked: bool,
+    pub has_pattern_mode: bool,
+    pub pattern: Option<&'a PatternState>,
+    pub background: Option<&'a cairo::ImageSurface>,
+    pub alert: Option<&'a AlertView>,
+}
+
+pub fn render(context: &cairo::Context, frame: &Frame) {
+    let (init_w, init_h) = (frame.width, frame.height);
+    let scale = frame.scale;
+
+    if frame.permalocked {
+        set_color(context, LOVE);
+        context.paint().unwrap();
+    } else if frame.inverted {
+        set_color(context, TEXT);
+        context.paint().unwrap();
+    } else if let Some(background) = frame.background {
+        paint_cover(context, background, init_w, init_h);
+    } else {
+        set_color(context, BASE);
+        context.paint().unwrap();
+    }
+    if frame.inverted {
+        set_color(context, BASE);
+    } else {
+        set_color(context, TEXT);
+    }
+
+    // draw status line
+    let layout = pangocairo::functions::create_layout(context);
+    layout.set_font_description(Some(frame.fontdesc_status));
+    layout.set_markup(frame.status);
+    let (layout_w, _) = layout.pixel_size();
+    context.move_to(
+        (init_w as f64 / 2.0) - (layout_w as f64 / 2.0),
+        (50 * scale) as f64,
+    );
+    pangocairo::functions::show_layout(context, &layout);
+
+    //draw time
+    let timestring = frame.time.format("%H:%M").to_string();
+    let layout = pangocairo::functions::create_layout(context);
+    layout.set_font_description(Some(frame.fontdesc_time));
+    layout.set_text(&timestring);
+    let (layout_w, layout_h) = layout.pixel_size();
+    // in pattern mode the dots take the lower part of the screen
+    let time_center_y = if frame.has_pattern_mode {
+        init_h as f64 * 0.28
+    } else {
+        init_h as f64 / 2.0
+    };
+    context.move_to(
+        (init_w as f64 / 2.0) - (layout_w as f64 / 2.0),
+        time_center_y - (layout_h as f64 / 2.0),
+    );
+    pangocairo::functions::show_layout(context, &layout);
+
+    //draw date below the time
+    let mut fontdesc_date = frame.fontdesc_status.clone();
+    fontdesc_date.set_size(22 * pango::SCALE * scale);
+    let date_layout = pangocairo::functions::create_layout(context);
+    date_layout.set_font_description(Some(&fontdesc_date));
+    date_layout.set_text(&frame.time.format("%A, %-d %B").to_string());
+    let (date_w, _) = date_layout.pixel_size();
+    context.move_to(
+        (init_w as f64 / 2.0) - (date_w as f64 / 2.0),
+        time_center_y + (layout_h as f64 / 2.0) + (8 * scale) as f64,
+    );
