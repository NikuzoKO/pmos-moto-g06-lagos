+fn paint_cover(context: &cairo::Context, image: &cairo::ImageSurface, width: i32, height: i32) {
+    let (image_w, image_h) = (image.width() as f64, image.height() as f64);
+    let factor = (width as f64 / image_w).max(height as f64 / image_h);
+    let offset_x = (width as f64 - image_w * factor) / 2.0;
+    let offset_y = (height as f64 - image_h * factor) / 2.0;
+    context.save().unwrap();
+    context.translate(offset_x, offset_y);
+    context.scale(factor, factor);
+    context.set_source_surface(image, 0.0, 0.0).unwrap();
+    context.paint().unwrap();
+    context.restore().unwrap();
