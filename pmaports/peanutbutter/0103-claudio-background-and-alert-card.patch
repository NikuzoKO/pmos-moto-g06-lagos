@@ -0,0 +1,432 @@
+// Claudio alert card: an assistant (running as the same user) can ask the lock screen to show a
+// card with a title, a message and up to four answer buttons, without unlocking the phone.
+//
+// Request file  $XDG_RUNTIME_DIR/claudio-alert/request  (key=value lines):
+//     title=Time to start
+//     message=Put 5 dishes in the sink
+//     button=started|Starting now
+//     button=snooze5|Not yet - 5 more min
+// Answer file   $XDG_RUNTIME_DIR/claudio-alert/answer   (the id of the tapped button)
+//
+// The card can never unlock the session. A stale or malformed request can never trap the user
+// either: see `accept_file` (age, owner, size) and `parse` (at least one button, capped fields).
+
+use std::fs;
+use std::io::Write;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime};
+
+use cairo;
+use pangocairo;
+
+use crate::draw::{set_color, BASE, IRIS, OVERLAY, SURFACE, TEXT};
+
+pub const MAX_AGE: Duration = Duration::from_secs(15 * 60);
+const MAX_FILE_SIZE: u64 = 4096;
+const MAX_TITLE: usize = 80;
+const MAX_MESSAGE: usize = 300;
+const MAX_BUTTONS: usize = 4;
+const MAX_ID: usize = 32;
+const MAX_LABEL: usize = 40;
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct AlertRequest {
+    pub title: String,
+    pub message: String,
+    pub buttons: Vec<(String, String)>, // (id, label)
+}
+
+fn clean(text: &str, max_chars: usize) -> String {
+    text.chars()
+        .filter(|character| !character.is_control())
+        .take(max_chars)
+        .collect::<String>()
+        .trim()
+        .to_string()
+}
+
+fn valid_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= MAX_ID
+        && id
+            .chars()
+            .all(|character| character.is_ascii_alphanumeric() || character == '_' || character == '-')
+}
+
+/// Parse a request. Needs at least one valid button, so a card can always be dismissed.
+pub fn parse(text: &str) -> Option<AlertRequest> {
+    let mut title = String::new();
+    let mut message = String::new();
+    let mut buttons: Vec<(String, String)> = Vec::new();
+    for line in text.lines() {
+        let Some((key, value)) = line.split_once('=') else {
+            continue;
+        };
+        match key.trim() {
+            "title" => title = clean(value, MAX_TITLE),
+            "message" => message = clean(value, MAX_MESSAGE),
+            "button" => {
+                let Some((id, label)) = value.split_once('|') else {
+                    continue;
+                };
+                let (id, label) = (id.trim(), clean(label, MAX_LABEL));
+                if valid_id(id) && !label.is_empty() && buttons.len() < MAX_BUTTONS {
+                    buttons.push((id.to_string(), label));
+                }
+            }
+            _ => {}
+        }
+    }
+    if buttons.is_empty() {
+        return None;
+    }
+    Some(AlertRequest {
+        title,
+        message,
+        buttons,
+    })
+}
+
+/// Is a request file we may trust? Regular file, ours, small, and recent.
+pub fn accept_file(
+    is_regular_file: bool,
+    file_uid: u32,
+    my_uid: u32,
+    size: u64,
+    modified: SystemTime,
+    now: SystemTime,
+) -> bool {
+    if !is_regular_file || file_uid != my_uid || size == 0 || size > MAX_FILE_SIZE {
+        return false;
+    }
+    match now.duration_since(modified) {
+        Ok(age) => age <= MAX_AGE,
+        // modified in the future (clock jump): allow a minute of slack, no more
+        Err(error) => error.duration() <= Duration::from_secs(60),
+    }
+}
+
+/// Is the alert directory ours and not writable by anyone else?
+pub fn accept_dir(is_dir: bool, dir_uid: u32, my_uid: u32, mode: u32) -> bool {
+    is_dir && dir_uid == my_uid && mode & 0o022 == 0
+}
+
+pub fn alert_dir() -> Option<PathBuf> {
+    let runtime = std::env::var_os("XDG_RUNTIME_DIR")?;
+    Some(PathBuf::from(runtime).join("claudio-alert"))
+}
+
+/// Cheap identity of the request file, to notice when it changed
+pub type Signature = (SystemTime, u64);
+
+/// Read the current request, if there is a trustworthy one. Returns its signature too.
+pub fn load(dir: &Path, now: SystemTime) -> Option<(AlertRequest, Signature)> {
+    let my_uid = unsafe { libc::getuid() };
+    let dir_metadata = fs::symlink_metadata(dir).ok()?;
+    if !accept_dir(
+        dir_metadata.is_dir(),
+        dir_metadata.uid(),
+        my_uid,
+        dir_metadata.mode(),
+    ) {
+        return None;
+    }
+    let path = dir.join("request");
+    let metadata = fs::symlink_metadata(&path).ok()?; // symlink_metadata: never follow links
+    let modified = metadata.modified().ok()?;
+    if !accept_file(
+        metadata.is_file(),
+        metadata.uid(),
+        my_uid,
+        metadata.len(),
+        modified,
+        now,
+    ) {
+        return None;
+    }
+    let text = fs::read_to_string(&path).ok()?;
+    Some((parse(&text)?, (modified, metadata.len())))
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Rect {
+    pub x: f64,
+    pub y: f64,
+    pub w: f64,
+    pub h: f64,
+}
+
+impl Rect {
+    pub fn contains(&self, x: f64, y: f64) -> bool {
+        x >= self.x && x <= self.x + self.w && y >= self.y && y <= self.y + self.h
+    }
+}
+
+const PADDING: f64 = 20.0;
+const TITLE_HEIGHT: f64 = 44.0;
+const MESSAGE_HEIGHT: f64 = 100.0;
+const BUTTON_HEIGHT: f64 = 56.0;
+const BUTTON_GAP: f64 = 12.0;
+
+/// A request plus where it sits on screen (logical coordinates, like touch events)
+#[derive(Clone, Debug)]
+pub struct AlertView {
+    pub request: AlertRequest,
+    pub signature: Option<Signature>,
+    card: Rect,
+    buttons: Vec<Rect>,
+}
+
+impl AlertView {
+    pub fn new(request: AlertRequest, signature: Option<Signature>) -> Self {
+        Self {
+            request,
+            signature,
+            card: Rect::default(),
+            buttons: Vec::new(),
+        }
+    }
+
+    /// Fixed geometry (no text measuring), so hit-testing never depends on a drawn frame
+    pub fn layout(&mut self, width: i32, height: i32) {
+        let (width, height) = (width as f64, height as f64);
+        let count = self.request.buttons.len() as f64;
+        let card_width = width * 0.88;
+        let card_height = PADDING
+            + TITLE_HEIGHT
+            + MESSAGE_HEIGHT
+            + count * BUTTON_HEIGHT
+            + (count - 1.0) * BUTTON_GAP
+            + PADDING;
+        self.card = Rect {
+            x: (width - card_width) / 2.0,
+            y: height * 0.36,
+            w: card_width,
+            h: card_height,
+        };
+        let first_button_y = self.card.y + PADDING + TITLE_HEIGHT + MESSAGE_HEIGHT;
+        self.buttons = (0..self.request.buttons.len())
+            .map(|index| Rect {
+                x: self.card.x + PADDING,
+                y: first_button_y + index as f64 * (BUTTON_HEIGHT + BUTTON_GAP),
+                w: self.card.w - 2.0 * PADDING,
+                h: BUTTON_HEIGHT,
+            })
+            .collect();
+    }
+
+    pub fn hit(&self, x: f64, y: f64) -> Option<usize> {
+        self.buttons.iter().position(|button| button.contains(x, y))
+    }
+
+    pub fn id_of(&self, index: usize) -> Option<&str> {
+        self.request
+            .buttons
+            .get(index)
+            .map(|(id, _label)| id.as_str())
+    }
+
+    pub fn draw(&self, context: &cairo::Context, base_font: &pango::FontDescription, scale: i32) {
+        let scale = scale as f64;
+        if self.buttons.is_empty() {
+            return;
+        }
+
+        // dim everything behind the card
+        context.set_source_rgba(BASE.0, BASE.1, BASE.2, 0.55);
+        context.paint().unwrap();
+
+        let card = self.card;
+        rounded_rect(context, card.x * scale, card.y * scale, card.w * scale, card.h * scale, 22.0 * scale);
+        context.set_source_rgba(SURFACE.0, SURFACE.1, SURFACE.2, 0.96);
+        context.fill().unwrap();
+
+        let inner_width = (card.w - 2.0 * PADDING) * scale;
+        let text_x = (card.x + PADDING) * scale;
+
+        let mut title_font = base_font.clone();
+        title_font.set_size((22.0 * scale * pango::SCALE as f64) as i32);
+        title_font.set_weight(pango::Weight::Bold);
+        let layout = pangocairo::functions::create_layout(context);
+        layout.set_font_description(Some(&title_font));
+        layout.set_text(&self.request.title);
+        layout.set_width((inner_width * pango::SCALE as f64) as i32);
+        layout.set_ellipsize(pango::EllipsizeMode::End);
+        layout.set_alignment(pango::Alignment::Center);
+        set_color(context, IRIS);
+        context.move_to(text_x, (card.y + PADDING) * scale);
+        pangocairo::functions::show_layout(context, &layout);
+
+        let mut message_font = base_font.clone();
+        message_font.set_size((16.0 * scale * pango::SCALE as f64) as i32);
+        let layout = pangocairo::functions::create_layout(context);
+        layout.set_font_description(Some(&message_font));
+        layout.set_text(&self.request.message);
+        layout.set_width((inner_width * pango::SCALE as f64) as i32);
+        layout.set_height(-3); // at most 3 lines
+        layout.set_wrap(pango::WrapMode::WordChar);
+        layout.set_ellipsize(pango::EllipsizeMode::End);
+        layout.set_alignment(pango::Alignment::Center);
+        set_color(context, TEXT);
+        context.move_to(text_x, (card.y + PADDING + TITLE_HEIGHT) * scale);
+        pangocairo::functions::show_layout(context, &layout);
+
+        let mut button_font = base_font.clone();
+        button_font.set_size((18.0 * scale * pango::SCALE as f64) as i32);
+        for (index, (button, (_id, label))) in self
+            .buttons
+            .iter()
+            .zip(self.request.buttons.iter())
+            .enumerate()
+        {
+            rounded_rect(
+                context,
+                button.x * scale,
+                button.y * scale,
+                button.w * scale,
+                button.h * scale,
+                16.0 * scale,
+            );
+            set_color(context, if index == 0 { IRIS } else { OVERLAY });
+            context.fill().unwrap();
+
+            let layout = pangocairo::functions::create_layout(context);
+            layout.set_font_description(Some(&button_font));
+            layout.set_text(label);
+            layout.set_width(((button.w - 16.0) * scale * pango::SCALE as f64) as i32);
+            layout.set_ellipsize(pango::EllipsizeMode::End);
+            layout.set_alignment(pango::Alignment::Center);
+            let (_, text_height) = layout.pixel_size();
+            set_color(context, if index == 0 { BASE } else { TEXT });
+            context.move_to(
+                (button.x + 8.0) * scale,
+                button.y * scale + (button.h * scale - text_height as f64) / 2.0,
+            );
+            pangocairo::functions::show_layout(context, &layout);
+        }
+    }
+}
+
+fn rounded_rect(context: &cairo::Context, x: f64, y: f64, w: f64, h: f64, radius: f64) {
+    let tau = std::f64::consts::TAU;
+    context.new_sub_path();
+    context.arc(x + w - radius, y + radius, radius, -tau / 4.0, 0.0);
+    context.arc(x + w - radius, y + h - radius, radius, 0.0, tau / 4.0);
+    context.arc(x + radius, y + h - radius, radius, tau / 4.0, tau / 2.0);
+    context.arc(x + radius, y + radius, radius, tau / 2.0, tau * 3.0 / 4.0);
+    context.close_path();
+}
+
+/// Record the answer (atomically) and remove the request. Never touches the lock.
+pub fn answer(dir: &Path, id: &str) -> std::io::Result<()> {
+    let result = (|| {
+        let temporary = dir.join("answer.tmp");
+        let mut file = fs::File::create(&temporary)?;
+        file.write_all(id.as_bytes())?;
+        file.sync_all()?;
+        fs::rename(&temporary, dir.join("answer"))
+    })();
+    // Even if the answer could not be recorded, the request goes away: a card must never come
+    // back every second and trap the touch input.
+    let _ = fs::remove_file(dir.join("request"));
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn good() -> &'static str {
+        "title=Time to start\nmessage=Dishes\nbutton=started|Starting now\nbutton=skipped|Skip today\n"
+    }
+
+    #[test]
+    fn parses_a_normal_request() {
+        let request = parse(good()).unwrap();
+        assert_eq!(request.title, "Time to start");
+        assert_eq!(request.buttons.len(), 2);
+        assert_eq!(request.buttons[0], ("started".into(), "Starting now".into()));
+    }
+
+    #[test]
+    fn no_valid_button_means_no_card() {
+        assert!(parse("title=x\nmessage=y\n").is_none());
+        assert!(parse("button=bad id|Label\n").is_none()); // space in id
+        assert!(parse("button=ok|\n").is_none()); // empty label
+        assert!(parse("button=|Label\n").is_none()); // empty id
+    }
+
+    #[test]
+    fn caps_fields_and_strips_control_characters() {
+        let long = "x".repeat(1000);
+        let request = parse(&format!(
+            "title={long}\nmessage=a\u{1b}[31mb\u{7}c\nbutton=a|{long}\n"
+        ))
+        .unwrap();
+        assert_eq!(request.title.chars().count(), MAX_TITLE);
+        assert_eq!(request.message, "a[31mbc");
+        assert_eq!(request.buttons[0].1.chars().count(), MAX_LABEL);
+    }
+
+    #[test]
+    fn at_most_four_buttons() {
+        let text: String = (0..9).map(|n| format!("button=b{n}|B{n}\n")).collect();
+        assert_eq!(parse(&text).unwrap().buttons.len(), MAX_BUTTONS);
+    }
+
+    #[test]
+    fn rejects_stale_foreign_huge_or_odd_files() {
+        let now = SystemTime::now();
+        let recent = now - Duration::from_secs(30);
+        assert!(accept_file(true, 1000, 1000, 100, recent, now));
+        assert!(!accept_file(true, 1000, 1000, 100, now - MAX_AGE - Duration::from_secs(1), now)); // stale
+        assert!(!accept_file(true, 0, 1000, 100, recent, now)); // someone else's
+        assert!(!accept_file(true, 1000, 1000, MAX_FILE_SIZE + 1, recent, now)); // huge
+        assert!(!accept_file(true, 1000, 1000, 0, recent, now)); // empty
+        assert!(!accept_file(false, 1000, 1000, 100, recent, now)); // symlink/dir/device
+        assert!(!accept_file(true, 1000, 1000, 100, now + Duration::from_secs(3600), now)); // future
+    }
+
+    #[test]
+    fn dir_must_be_ours_and_private() {
+        assert!(accept_dir(true, 1000, 1000, 0o700));
+        assert!(accept_dir(true, 1000, 1000, 0o755));
+        assert!(!accept_dir(true, 1000, 1000, 0o775)); // group-writable
+        assert!(!accept_dir(true, 1000, 1000, 0o777));
+        assert!(!accept_dir(true, 0, 1000, 0o700));
+        assert!(!accept_dir(false, 1000, 1000, 0o700));
+    }
+
+    #[test]
+    fn hit_testing_matches_layout() {
+        let mut view = AlertView::new(parse(good()).unwrap(), None);
+        view.layout(360, 820);
+        let first = view.buttons[0];
+        let second = view.buttons[1];
+        assert_eq!(view.hit(first.x + 5.0, first.y + 5.0), Some(0));
+        assert_eq!(view.hit(second.x + 5.0, second.y + 5.0), Some(1));
+        assert_eq!(view.hit(1.0, 1.0), None); // outside the card: no button, no unlock
+        assert_eq!(view.id_of(1), Some("skipped"));
+        assert_eq!(view.id_of(2), None);
+    }
+
+    #[test]
+    fn card_fits_the_screen_with_four_buttons() {
+        let text: String = (0..4).map(|n| format!("button=b{n}|B{n}\n")).collect();
+        let mut view = AlertView::new(parse(&text).unwrap(), None);
+        view.layout(360, 820);
+        assert!(view.card.y + view.card.h < 820.0);
+    }
+
+    #[test]
+    fn answer_is_written_and_request_removed() {
+        let dir = std::env::temp_dir().join(format!("pb-alert-test-{}", std::process::id()));
+        fs::create_dir_all(&dir).unwrap();
+        fs::write(dir.join("request"), good()).unwrap();
+        answer(&dir, "started").unwrap();
+        assert_eq!(fs::read_to_string(dir.join("answer")).unwrap(), "started");
+        assert!(!dir.join("request").exists());
+        fs::remove_dir_all(&dir).unwrap();
+    }
+}
