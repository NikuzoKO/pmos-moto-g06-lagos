+/// Render one frame to a PNG without Wayland and without locking anything, to check layouts.
+fn preview(
+    out: &str,
+    fontname: &str,
+    pattern_mode: bool,
+    background: Option<&cairo::ImageSurface>,
+    alert_file: Option<&str>,
+) {
+    let (logical_w, logical_h, scale) = (360, 820, 2);
+    let mut fontdesc_time = pango::FontDescription::new();
+    fontdesc_time.set_family(fontname);
+    fontdesc_time.set_size(60 * pango::SCALE * scale);
+    let mut fontdesc_status = pango::FontDescription::new();
+    fontdesc_status.set_family(fontname);
+    fontdesc_status.set_size(16 * pango::SCALE * scale);
+
+    let mut view = alert_file.map(|path| {
+        let text = std::fs::read_to_string(path).expect("cannot read the --preview-alert file");
+        let request = alert::parse(&text).expect("the --preview-alert file has no valid button");
+        let mut view = AlertView::new(request, None);
+        view.layout(logical_w, logical_h);
+        view
+    });
+    let pattern = pattern_mode.then(|| PatternState::new(logical_w, logical_h, Some("14789"), 10));
+
+    let (width, height) = (logical_w * scale, logical_h * scale);
+    let surface = cairo::ImageSurface::create(cairo::Format::ARgb32, width, height).unwrap();
+    let context = cairo::Context::new(&surface).unwrap();
+    let frame = draw::Frame {
+        width,
+        height,
+        scale,
+        fontdesc_time: &fontdesc_time,
+        fontdesc_status: &fontdesc_status,
+        status: "preview",
+        time: chrono::Local::now(),
+        inverted: false,
+        permalocked: false,
+        has_pattern_mode: pattern.is_some(),
+        pattern: pattern.as_ref(),
+        background,
+        alert: view.as_mut().map(|view| &*view),
+    };
+    draw::render(&context, &frame);
+    drop(context);
+    let mut file = std::fs::File::create(out).expect("cannot create the preview file");
+    surface.write_to_png(&mut file).expect("cannot write the preview png");
+}
